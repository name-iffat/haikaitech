---
import { Image } from 'astro:assets';
import avsLogo from '../assets/logos/avsbina-logo.png';
import adyUmrahLogo from '../assets/logos/adyumrah-logo.png';
import fuzzfloorLogo from '../assets/logos/fuzzfloor-logo.png';
import atOneLogo from '../assets/logos/atone-logo.png';
import aaBurgerLogo from '../assets/logos/AAburger-kiosk-logo.png';
import cityThreeLogo from '../assets/logos/citythree-logo.png';
import hssLogo from '../assets/logos/hss-logo.png';
import kopiTebuLogo from '../assets/logos/kopitebu-logo.png';
import zakrulLogo from '../assets/logos/logo-ghost-outline.webp';
import { bmHome } from '../data/locales/bm-home';
import type { SiteLocale } from '../utils/i18n';

interface Props { locale?: SiteLocale; }
const { locale = 'en' } = Astro.props;
const isBm = locale === 'bm';

// Only show logo assets paired with a published project page or verified live destination.
const clientLogos = [
  { id: 'avs', name: 'AVS Design & Construction', href: '/projects/avsbina/', logo: avsLogo },
  { id: 'adyumrah', name: 'Ady Umrah Hajj', href: '/projects/adyumrah/', logo: adyUmrahLogo },
  { id: 'fuzzfloor', name: 'Fuzzfloor', href: '/projects/fuzzfloor/', logo: fuzzfloorLogo },
  { id: 'atone', name: 'AT One Construction', href: '/projects/atone/', logo: atOneLogo },
  { id: 'aaburger', name: 'AA Burger Kiosk', href: 'https://aaburger.haikaitech.my/', logo: aaBurgerLogo, external: true },
  { id: 'citythree', name: 'CityThree', href: 'https://citythree.my/', logo: cityThreeLogo, external: true },
  { id: 'hss', name: 'HSS Wireless CCTV', href: 'https://wirelesscctv.com.my/', logo: hssLogo, external: true },
  { id: 'kopitebu', name: 'Kopi Tebu', href: 'https://kopitebu-website.pages.dev/', logo: kopiTebuLogo, external: true },
  { id: 'zakrul', name: 'Zakrul', href: 'https://zakrul.com/', logo: zakrulLogo, external: true },
];
---

<section id="trust" class="workbench wb-trust" aria-label={isBm ? 'Bukti pelanggan' : 'Client proof'}>
  <div class="wb-trust-head">
    <h2 class="wb-trust-heading">{isBm ? bmHome.trust.heading : 'Our amazing clients'}</h2>
    <button class="wb-client-motion" type="button" aria-label={isBm ? bmHome.trust.pause : 'Pause client logo animation'} aria-pressed="false">{isBm ? 'Jeda' : 'Pause'}</button>
  </div>
  <div class="wb-trust-register">
    <div class="wb-client-track">
    <ul class="wb-client-list" aria-label={isBm ? 'Projek pelanggan HaikaiTech yang disahkan' : 'Verified HaikaiTech client projects'}>
      {clientLogos.map((client) => (
        <li>
          <a href={client.href} aria-label={isBm ? `Lihat projek ${client.name}` : `View ${client.name} project`} target={client.external ? '_blank' : undefined} rel={client.external ? 'noopener noreferrer' : undefined}>
            <Image class={`wb-client-logo wb-client-logo--${client.id}`} src={client.logo} width={300} format="webp" quality={80} alt={client.name} loading="lazy" />
          </a>
        </li>
      ))}
    </ul>
    <ul class="wb-client-list wb-client-list--duplicate" aria-hidden="true">
      {clientLogos.map((client) => (
        <li>
          <span class="wb-client-repeat">
            <Image class={`wb-client-logo wb-client-logo--${client.id}`} src={client.logo} width={300} format="webp" quality={80} alt="" loading="lazy" />
          </span>
        </li>
      ))}
    </ul>
    </div>
  </div>
</section>

<script>
  const trust = document.querySelector<HTMLElement>('#trust');
  const motionButton = trust?.querySelector<HTMLButtonElement>('.wb-client-motion');
  motionButton?.addEventListener('click', () => {
    const paused = trust?.classList.toggle('wb-trust--paused') ?? false;
    motionButton.setAttribute('aria-pressed', String(paused));
    const isBm = document.documentElement.lang.toLowerCase().startsWith('ms');
    motionButton.setAttribute('aria-label', isBm
      ? paused ? 'Mainkan gerakan logo pelanggan' : 'Jeda gerakan logo pelanggan'
      : paused ? 'Play client logo animation' : 'Pause client logo animation');
    motionButton.textContent = isBm ? paused ? 'Main' : 'Jeda' : paused ? 'Play' : 'Pause';
  });
</script>
