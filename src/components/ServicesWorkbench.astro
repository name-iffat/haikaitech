---
import { Image } from 'astro:assets';
import fuzzfloorImg from '../assets/projects/fuzzfloor.webp';
import workforceDemoImg from '../assets/projects/mze-workforce-demo.png';
import aaBurgerImg from '../assets/projects/aaburger-kiosk-desktop.png';
import browserBuilder from '../assets/concept-decorations/refined/service-browser-builder.png';
import systemsAssembly from '../assets/concept-decorations/refined/service-systems-assembly.png';
import productWorkbench from '../assets/concept-decorations/refined/service-product-workbench.png';
import careToolkit from '../assets/concept-decorations/refined/service-care-toolkit.png';
// Conceptual workflow artwork, separate from the real project screenshots above.
import automationIllustration from '../assets/concept-decorations/refined/home-automation-workflow.png';
import ecommerceIllustration from '../assets/concept-decorations/service-ecommerce-clay.png';
import { SKILLS } from '../../constants';
import WorkbenchIcon from './WorkbenchIcon.astro';
import { serviceExtensions } from '../data/services';
import { bmHome } from '../data/locales/bm-home';
import { localizeHref, type SiteLocale } from '../utils/i18n';

interface Props { locale?: SiteLocale; }
const { locale = 'en' } = Astro.props;
const isBm = locale === 'bm';

const englishServices = [
  {
    icon: 'globe',
    title: ['Business', 'websites'],
    label: 'Company sites / Enquiries',
    type: 'website',
    description: 'Help customers understand your business and take the next step, from their first visit to a WhatsApp enquiry.',
    href: '/services/',
    action: 'Explore website plans',
  },
  {
    icon: 'workflow',
    title: ['Business', 'systems'],
    label: 'Dashboards / Internal tools',
    type: 'system',
    description: "Bring your team's day-to-day processes into a system that fits how you work.",
    href: 'https://mzdemo.haikaitech.my/',
    action: 'Explore the system demo',
  },
  {
    icon: 'blocks',
    title: ['Digital products', '& experiences'],
    label: 'Customer tools / Interactive demos',
    type: 'product',
    description: 'Turn a useful idea into something people can use, explore and interact with.',
    href: 'https://aaburger.haikaitech.my/',
    action: 'Explore AA Burger Kiosk',
  },
  {
    icon: 'wrench',
    title: ['Website', 'care'],
    label: 'Updates / Maintenance',
    type: 'care',
    description: 'Keep your site current as your business changes, with post-launch updates quoted around what you need.',
    href: '/services/',
    action: 'View support options',
  },
];
const services = englishServices.map((service, index) => isBm
  ? { ...service, ...bmHome.services.rows[index], href: localizeHref(service.href, locale) }
  : service);
---

<section id="services" class="workbench wb-services" aria-labelledby="services-title">
  <header class="wb-services-head">
    <div>
      <p class="wb-eyebrow">{isBm ? bmHome.services.eyebrow : 'Ways we help'}</p>
      <h2 id="services-title">{isBm ? <>{bmHome.services.title[0]}<br />{bmHome.services.title[1]}</> : <>Serious builds.<br />A little <em>character.</em></>}</h2>
    </div>
    <div class="wb-services-intro">
      <p>{isBm ? bmHome.services.intro : 'Websites for your customers. Systems for your team. Useful ideas, built around your business.'}</p>
    </div>
  </header>

  <div class="wb-services-list">
    {services.map((service) => (
      <article class:list={['wb-service-row', `wb-service-row--${service.type}`]}>
        <span class="wb-service-icon" aria-hidden="true"><WorkbenchIcon name={service.icon} /></span>
        <div class="wb-service-title">
          <h3>{service.title.map((line) => <>{line}<br /></>)}</h3>
          <p>{service.label}</p>
        </div>

        <div class="wb-service-object" aria-hidden="true">
          {service.type === 'website' && (
            <>
              <div class="wb-service-browser wb-service-browser--website">
                <div class="wb-service-browser-bar"><span>● ● ●</span> FUZZFLOOR / MOBILE COMMERCE</div>
                <Image src={fuzzfloorImg} alt="" width={500} />
              </div>
              <Image
                class="wb-service-browser-builder"
                src={browserBuilder}
                alt=""
                aria-hidden="true"
                width={440}
                loading="lazy"
              />
              <span class="wb-service-scribble">built to earn its keep</span>
            </>
          )}
          {service.type === 'system' && (
            <>
              <Image
                class="wb-service-assembly wb-service-assembly--systems"
                src={systemsAssembly}
                alt=""
                aria-hidden="true"
                width={700}
                loading="lazy"
              />
              <div class="wb-service-browser wb-service-browser--system">
                <Image src={workforceDemoImg} alt="" width={700} />
                <div class="wb-service-browser-bar">MZE WORKER SYSTEM / DEMO</div>
              </div>
            </>
          )}
          {service.type === 'product' && (
            <div class="wb-service-scene wb-service-scene--product">
              <Image
                class="wb-service-assembly wb-service-assembly--product"
                src={productWorkbench}
                alt=""
                aria-hidden="true"
                width={700}
                loading="lazy"
              />
              <div class="wb-service-monitor-screen">
                <Image src={aaBurgerImg} alt="" width={700} />
              </div>
            </div>
          )}
          {service.type === 'care' && (
            <div class="wb-service-scene wb-service-scene--care">
              <Image
                class="wb-service-assembly wb-service-assembly--care"
                src={careToolkit}
                alt=""
                aria-hidden="true"
                width={700}
                loading="lazy"
              />
              <div class="wb-service-checklist wb-service-checklist--care">
                <strong>{isBm ? bmHome.services.careTitle : 'CARE / CHECKLIST'}</strong>
                {bmHome.services.careItems.map((label, index) => <span><i>✓</i> {isBm ? label : ['Content updates', 'Maintenance', 'Small changes'][index]}</span>)}
              </div>
            </div>
          )}
        </div>

        <div class="wb-service-copy">
          <p>{service.description}</p>
          <a href={service.href} target={service.href.startsWith('http') ? '_blank' : undefined} rel={service.href.startsWith('http') ? 'noopener noreferrer' : undefined}>
            {service.action}
          </a>
        </div>
      </article>
    ))}
  </div>

  <section class="wb-services-extensions" aria-labelledby="services-extensions-title">
    <header>
      <h3 id="services-extensions-title">{isBm ? bmHome.services.extensionsTitle : 'Extend the build.'}</h3>
      <span>{isBm ? bmHome.services.extensionsNote : 'new paths, same workshop'}</span>
    </header>
    <div class="wb-services-extension-list">
      {serviceExtensions.map((extension) => (
        <article class:list={['wb-services-extension', `wb-services-extension--${extension.slug}`]}>
          <div class="wb-services-extension-visual">
            <Image
              src={extension.slug === 'automation' ? automationIllustration : ecommerceIllustration}
              alt={isBm ? extension.slug === 'automation' ? bmHome.services.automationAlt : bmHome.services.ecommerceAlt : extension.slug === 'automation'
                ? 'An AI helper connects an incoming enquiry to organised tasks and a person’s approval.'
                : 'A shop helper presents a digital storefront with products, a parcel and an order receipt.'}
              widths={[360, 560, 800]}
              sizes="(max-width: 767px) calc(100vw - 48px), (max-width: 1199px) 44vw, 560px"
              width={800}
              format="webp"
              loading="lazy"
            />
          </div>
          <div class="wb-services-extension-copy">
            <h4>{isBm ? extension.slug === 'automation' ? bmHome.services.automationTitle : bmHome.services.ecommerceTitle : extension.title}</h4>
            <p>{isBm ? extension.slug === 'automation' ? bmHome.services.automationDesc : bmHome.services.ecommerceDesc : extension.slug === 'automation'
              ? 'A digital helper that sorts enquiries, prepares tasks and connects your tools. Your team reviews the important decisions.'
              : 'Your online shop, from browsing products to checkout and managing orders. Built around how your business sells.'}</p>
            <p class="wb-services-extension-flow" aria-label={isBm ? 'Cara ia berfungsi' : 'How it works'}>
              {isBm ? extension.slug === 'automation' ? bmHome.services.automationFlow : bmHome.services.ecommerceFlow : extension.slug === 'automation' ? 'Enquiry → AI helper → Your review' : 'Products → Checkout → Orders'}
            </p>
            <div class="wb-services-extension-bottom">
              <span class="wb-services-extension-platforms">{isBm ? extension.slug === 'automation' ? bmHome.services.platformsAutomation : bmHome.services.platformsEcommerce : extension.slug === 'automation' ? 'Hermes / n8n / Custom scripts' : 'Shopify / WooCommerce'}</span>
              <a class="wb-services-extension-action" href={localizeHref(extension.href, locale)}>{isBm ? extension.slug === 'automation' ? bmHome.services.automationAction : bmHome.services.ecommerceAction : extension.action}</a>
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>

  <details class="wb-services-tools">
    <summary>{isBm ? bmHome.services.tools : <>Tech, tools &amp; toys</>} <span>{isBm ? bmHome.services.behind : '— behind the build'}</span></summary>
    <div class="wb-services-tools-grid">
      {SKILLS.map((group) => (
        <section>
          <h3>{group.category}</h3>
          <ul>
            {group.items.map((skill) => <li>{skill}</li>)}
          </ul>
        </section>
      ))}
    </div>
  </details>

  <footer class="wb-services-footer">
    <p>{isBm ? bmHome.services.footer : 'A clear scope. A useful next step.'}</p>
    <a class="wb-button wb-primary" href={localizeHref('/services/', locale)}>{isBm ? bmHome.services.pricing : 'Explore services &amp; pricing'}</a>
  </footer>
</section>
