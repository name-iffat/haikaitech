---
import { bmHome } from '../data/locales/bm-home';
import type { SiteLocale } from '../utils/i18n';

interface Props { posts: any[]; locale?: SiteLocale; }
const { posts, locale = 'en' } = Astro.props as Props;
const isBm = locale === 'bm';
const [featured, ...entries] = posts;

const formatDate = (date: Date) =>
  new Intl.DateTimeFormat(isBm ? 'ms-MY' : 'en-GB', { day: '2-digit', month: 'short', year: 'numeric' })
    .format(date)
    .toUpperCase();
---

<section class="workbench wb-insights" aria-labelledby="insights-title">
  <header class="wb-insights-head">
    <p class="wb-eyebrow">{isBm ? bmHome.insights.eyebrow : 'Insights from the workshop'}</p>
    <a href="/blog/">{isBm ? bmHome.insights.all : 'All field notes'}</a>
  </header>

  {featured && (
    <div class="wb-notebook">
      <div class="wb-notebook-left-stage">
        <section class="wb-notebook-page wb-notebook-contents" data-notebook-contents aria-label={isBm ? 'Kandungan nota terkini' : 'Latest field note contents'}>
          <svg class="wb-ligne-rocket" width="112" height="112" viewBox="0 0 120 120" fill="none" aria-hidden="true">
            <path d="M18 98l12-9M10 86l10-7M28 108l9-8" stroke="#16202A" stroke-width="1.8" stroke-linecap="round" />
            <path d="M102 14l2 5 5 2-5 2-2 5-2-5-5-2 5-2Z" fill="#F4D35E" stroke="#16202A" stroke-width="1.4" stroke-linejoin="round" />
            <path d="M20 22l1.4 3.6L25 27l-3.6 1.4L20 32l-1.4-3.6L15 27l3.6-1.4Z" fill="#9AB8FA" stroke="#16202A" stroke-width="1.3" stroke-linejoin="round" />
            <circle cx="96" cy="92" r="3" fill="#F28466" stroke="#16202A" stroke-width="1.3" />
            <g transform="rotate(38 60 58)">
              <path d="M50 82c0 10 4 16 10 22 6-6 10-12 10-22Z" fill="#F4D35E" stroke="#16202A" stroke-width="1.8" stroke-linejoin="round" />
              <path d="M55 82c0 6 2 10 5 13 3-3 5-7 5-13Z" fill="#F28466" stroke="#16202A" stroke-width="1.4" stroke-linejoin="round" />
              <path d="M43 62l-12 14v10l12-6Z" fill="#1368E6" stroke="#16202A" stroke-width="1.8" stroke-linejoin="round" />
              <path d="M77 62l12 14v10l-12-6Z" fill="#1368E6" stroke="#16202A" stroke-width="1.8" stroke-linejoin="round" />
              <path d="M60 14c12 10 17 26 17 42v24H43V56c0-16 5-32 17-42Z" fill="#FAF8F3" stroke="#16202A" stroke-width="1.8" stroke-linejoin="round" />
              <path d="M60 14c7 6 11.5 14 14 22H46c2.5-8 7-16 14-22Z" fill="#F28466" stroke="#16202A" stroke-width="1.8" stroke-linejoin="round" />
              <circle cx="60" cy="52" r="7.5" fill="#9AB8FA" stroke="#16202A" stroke-width="1.8" />
              <path d="M56.5 49.5a4.5 4.5 0 0 1 4-2.4" stroke="#16202A" stroke-width="1.3" stroke-linecap="round" />
              <path d="M60 64v16" stroke="#16202A" stroke-width="1.6" />
              <rect x="46" y="80" width="28" height="5" rx="2" fill="#16202A" />
            </g>
          </svg>
          <p class="wb-notebook-label">{isBm ? bmHome.insights.label : 'The HaikaiTech notebook'}</p>
          <h2 id="insights-title">{isBm ? bmHome.insights.title : 'Field notes.'}</h2>
          <p class="wb-notebook-intro">{isBm ? bmHome.insights.intro : 'Things worth knowing before you build, launch or grow your website.'}</p>
          {isBm && <p class="wb-notebook-language" lang="ms-MY">Artikel penuh di bawah diterbitkan dalam Bahasa Inggeris.</p>}

          <ol class="wb-notebook-list">
            {[featured, ...entries].map((post, index) => (
              <li>
                <a href={`/blog/${post.id}/`}>
                  <span class="wb-notebook-index">{String(index + 1).padStart(2, '0')}</span>
                  <span>
                    <strong lang={post.data.lang}>{post.data.title}</strong>
                    <small>{formatDate(post.data.pubDate)} / {post.data.tags[0]}</small>
                  </span>
                </a>
              </li>
            ))}
          </ol>
          <footer><span>{isBm ? bmHome.insights.contents : 'Contents / Latest entries'}</span><span>01</span></footer>
        </section>

        {[featured, ...entries].map((post, index) => (
          <article class="wb-notebook-page wb-notebook-left-leaf" data-notebook-left-leaf={index} aria-hidden="true">
            <p class="wb-notebook-label">{isBm ? bmHome.insights.fileNote : 'Filed note /'} {String(index + 1).padStart(2, '0')}</p>
            <p class="wb-notebook-left-note">{isBm ? bmHome.insights.turnedNote : 'Turned over from the workbench.'}</p>
            <h3 lang={post.data.lang}>{post.data.title}</h3>
            <p lang={post.data.lang}>{post.data.description}</p>
            <footer><span>{post.data.tags.slice(0, 2).join(' / ')}</span><span>TURNED</span></footer>
          </article>
        ))}
      </div>

      <article class="wb-notebook-page wb-notebook-feature">
        <span class="wb-notebook-bookmark" aria-hidden="true"></span>
        <svg class="wb-ligne-planet" width="140" height="120" viewBox="0 0 140 120" fill="none" aria-hidden="true">
          <defs>
            <pattern id="wb-ligne-dots" width="7" height="7" patternUnits="userSpaceOnUse">
              <circle cx="3.5" cy="3.5" r="1.5" fill="#1368E6" fill-opacity="0.32" />
            </pattern>
            <clipPath id="wb-ligne-cap"><rect x="0" y="0" width="140" height="57" /></clipPath>
          </defs>
          <circle cx="94" cy="46" r="40" fill="url(#wb-ligne-dots)" />
          <circle cx="64" cy="64" r="27" fill="#F4D35E" stroke="#16202A" stroke-width="1.8" />
          <path d="M40 56c14 5 34 5 48 0M39 72c16 5 34 5 50 0" stroke="#16202A" stroke-width="1.5" stroke-linecap="round" />
          <path fill-rule="evenodd" d="M64 50c26 0 46 6.3 46 14s-20 14-46 14-46-6.3-46-14 20-14 46-14Zm0 6c-21 0-38 3.6-38 8s17 8 38 8 38-3.6 38-8-17-8-38-8Z" fill="#F28466" stroke="#16202A" stroke-width="1.6" stroke-linejoin="round" transform="rotate(-12 64 64)" />
          <circle cx="64" cy="64" r="27" fill="#F4D35E" stroke="#16202A" stroke-width="1.8" clip-path="url(#wb-ligne-cap)" />
          <path d="M40 56c14 5 34 5 48 0" stroke="#16202A" stroke-width="1.5" stroke-linecap="round" clip-path="url(#wb-ligne-cap)" />
          <circle cx="120" cy="20" r="5" fill="#9AB8FA" stroke="#16202A" stroke-width="1.5" />
          <path d="M112 28c-6 6-14 9-22 9" stroke="#16202A" stroke-width="1.3" stroke-linecap="round" stroke-dasharray="2 4" />
          <path d="M22 18l1.8 4.4 4.4 1.8-4.4 1.8L22 30.4l-1.8-4.4-4.4-1.8 4.4-1.8Z" fill="#F4D35E" stroke="#16202A" stroke-width="1.3" stroke-linejoin="round" />
        </svg>
        <div id="notebook-pages" class="wb-notebook-stage" aria-live="polite">
          {[featured, ...entries].map((post, index) => (
            <article class:list={['wb-notebook-leaf', { 'is-active': index === 0 }]} aria-hidden={index === 0 ? undefined : 'true'}>
              <p class="wb-notebook-label">{isBm ? bmHome.insights.open : 'Open note /'} {formatDate(post.data.pubDate)}</p>
              {index === 0 && <p class="wb-notebook-note">{isBm ? 'Laman web sudah dilancarkan. Apa seterusnya?' : 'The website is live. Now what?'}</p>}
              <h3 lang={post.data.lang}>{post.data.title}</h3>
              <p class="wb-notebook-description" lang={post.data.lang}>{post.data.description}</p>
              <ul class="wb-notebook-topics" aria-label={isBm ? bmHome.insights.topics : 'Article topics'}>
                {post.data.tags.slice(0, 3).map((tag) => <li>{tag}</li>)}
              </ul>
              <a class="wb-notebook-read" href={`/blog/${post.id}/`}>{isBm ? bmHome.insights.read : 'Read the full note'}</a>
              <footer><span>{post.data.tags.slice(0, 2).join(' / ')}</span><span>{String(index + 2).padStart(2, '0')}</span></footer>
            </article>
          ))}
          <article class="wb-notebook-leaf wb-notebook-leaf--more" aria-hidden="true">
            <p class="wb-notebook-label">{isBm ? bmHome.insights.lastPage : 'Last page / Keep reading'}</p>
            <p class="wb-notebook-note">{isBm ? bmHome.insights.moreNote : 'More notes from the workshop.'}</p>
            <h3>{isBm ? bmHome.insights.moreTitle : 'There is more to explore.'}</h3>
            <p class="wb-notebook-description">{isBm ? bmHome.insights.moreDesc : 'Browse every field note on websites, pricing, software and finding your next customer.'}</p>
            <a class="wb-notebook-read" href="/blog/">{isBm ? bmHome.insights.openAll : 'Open all field notes'}</a>
            <footer><span>{isBm ? bmHome.insights.webLabel : 'HaikaiTech / Insights'}</span><span>{String(posts.length + 2).padStart(2, '0')}</span></footer>
          </article>
        </div>
      </article>

      <nav class="wb-notebook-controls" aria-label={isBm ? bmHome.insights.controls : 'Notebook page controls'}>
        <button type="button" data-notebook-previous aria-label={isBm ? bmHome.insights.previous : 'Previous notebook page'} aria-controls="notebook-pages" disabled>←</button>
        <span data-notebook-position>1 / {posts.length + 1}</span>
        <button type="button" data-notebook-next aria-label={isBm ? bmHome.insights.next : 'Next notebook page'} aria-controls="notebook-pages"><span aria-hidden="true">→</span></button>
      </nav>
    </div>
  )}
</section>

<script>
  const stage = document.querySelector<HTMLElement>('.wb-notebook-stage');
  const leaves = stage ? Array.from(stage.querySelectorAll<HTMLElement>('.wb-notebook-leaf')) : [];
  const contents = document.querySelector<HTMLElement>('[data-notebook-contents]');
  const leftLeaves = Array.from(document.querySelectorAll<HTMLElement>('[data-notebook-left-leaf]'));
  const previous = document.querySelector<HTMLButtonElement>('[data-notebook-previous]');
  const next = document.querySelector<HTMLButtonElement>('[data-notebook-next]');
  const position = document.querySelector<HTMLElement>('[data-notebook-position]');
  const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)');
  const twoPageSpread = matchMedia('(min-width: 1024px)');
  const notebook = document.querySelector<HTMLElement>('.wb-notebook');
  let current = 0;
  let isTurning = false;
  let wheelLocked = false;
  let pointerStartX = 0;
  let isPointerTracking = false;
  let suppressClick = false;
  let isIntersecting = true;

  if ('IntersectionObserver' in window && notebook) {
    const observer = new IntersectionObserver((entries) => {
      isIntersecting = entries[0]?.isIntersecting ?? true;
    }, { threshold: 0.05 });
    observer.observe(notebook);
  }

  const leftPageFor = (index: number) => index === 0 ? contents : leftLeaves[index - 1];

  const getPageCount = () => twoPageSpread.matches ? leaves.length : leaves.length + 1;

  const setMobilePage = (index: number) => {
    if (twoPageSpread.matches) {
      notebook?.classList.remove('is-mobile-contents', 'is-mobile-reading');
      contents?.removeAttribute('aria-hidden');
      contents?.removeAttribute('inert');
      stage?.removeAttribute('aria-hidden');
      stage?.removeAttribute('inert');
      return;
    }

    const isContents = index === 0;
    notebook?.classList.toggle('is-mobile-contents', isContents);
    notebook?.classList.toggle('is-mobile-reading', !isContents);
    contents?.toggleAttribute('aria-hidden', !isContents);
    contents?.toggleAttribute('inert', !isContents);
    stage?.toggleAttribute('aria-hidden', isContents);
    stage?.toggleAttribute('inert', isContents);

    if (!isContents) {
      const leafIndex = index - 1;
      leaves.forEach((leaf, i) => {
        const isActive = i === leafIndex;
        leaf.classList.toggle('is-active', isActive);
        leaf.toggleAttribute('aria-hidden', !isActive);
      });
    }
  };

  const setLeftPage = (index: number) => {
    if (!twoPageSpread.matches) {
      contents?.classList.remove('is-retiring');
      contents?.removeAttribute('aria-hidden');
      contents?.removeAttribute('inert');
      setMobilePage(index);
      return;
    }

    notebook?.classList.remove('is-mobile-contents', 'is-mobile-reading');
    stage?.removeAttribute('aria-hidden');
    stage?.removeAttribute('inert');
    const active = leftPageFor(index);
    [contents, ...leftLeaves].forEach((page) => {
      if (!page) return;
      const isActive = page === active;
      page.classList.toggle('is-active', isActive);
      page.classList.remove('is-revealing', 'is-retiring');
      // The turned leaves repeat the visible note only as a physical-page cue.
      // Keep the real reading page as the single screen-reader surface.
      page.toggleAttribute('aria-hidden', page !== contents || !isActive);
      page.toggleAttribute('inert', page === contents && !isActive);
    });
  };

  const updateControls = () => {
    if (!previous || !next || !position) return;
    const max = getPageCount();
    previous.disabled = isTurning || current === 0;
    next.disabled = isTurning || current >= max - 1;
    position.textContent = `${current + 1} / ${max}`;
  };

  const showPage = (target: number) => {
    const max = getPageCount();
    if (isTurning || target === current || target < 0 || target >= max) return;
    const isSpread = twoPageSpread.matches;
    isTurning = true;
    stage?.setAttribute('aria-busy', 'true');
    updateControls();

    if (isSpread) {
      const outgoing = leaves[current];
      const incoming = leaves[target];
      const outgoingLeft = leftPageFor(current);
      const incomingLeft = leftPageFor(target);
      const isForward = target > current;

      incoming.classList.add('is-underneath');
      outgoing.classList.add(isForward ? 'is-turning-forward' : 'is-turning-back');
      incomingLeft?.classList.add('is-revealing');
      outgoingLeft?.classList.add('is-retiring');

      const finishSpread = () => {
        outgoing.classList.remove('is-active', 'is-leaving', 'is-turning-forward', 'is-turning-back');
        outgoing.setAttribute('aria-hidden', 'true');
        incoming.classList.add('is-active');
        incoming.classList.remove('is-entering', 'is-underneath');
        incoming.removeAttribute('aria-hidden');

        outgoingLeft?.classList.remove('is-active', 'is-retiring');
        outgoingLeft?.setAttribute('aria-hidden', 'true');
        if (outgoingLeft === contents) outgoingLeft.setAttribute('inert', '');
        incomingLeft?.classList.add('is-active');
        incomingLeft?.classList.remove('is-revealing');
        if (incomingLeft === contents) {
          incomingLeft.removeAttribute('aria-hidden');
          incomingLeft.removeAttribute('inert');
        } else {
          incomingLeft?.setAttribute('aria-hidden', 'true');
        }

        current = target;
        isTurning = false;
        stage?.removeAttribute('aria-busy');
        updateControls();
      };

      if (reduceMotion.matches) {
        finishSpread();
        return;
      }
      window.setTimeout(finishSpread, 380);
    } else {
      const finishMobile = () => {
        current = target;
        setMobilePage(current);
        isTurning = false;
        stage?.removeAttribute('aria-busy');
        updateControls();
      };

      if (reduceMotion.matches) {
        finishMobile();
        return;
      }
      window.setTimeout(finishMobile, 120);
    }
  };

  previous?.addEventListener('click', () => showPage(current - 1));
  next?.addEventListener('click', () => showPage(current + 1));

  notebook?.addEventListener('wheel', (event) => {
    if (!isIntersecting) return;
    const horizontalDelta = Math.abs(event.deltaX) >= Math.abs(event.deltaY)
      ? event.deltaX
      : event.shiftKey
        ? event.deltaY
        : 0;
    if (!horizontalDelta) return;
    event.preventDefault();
    if (wheelLocked || isTurning) return;
    wheelLocked = true;
    showPage(current + (horizontalDelta > 0 ? 1 : -1));
    window.setTimeout(() => { wheelLocked = false; }, 420);
  }, { passive: false });

  notebook?.addEventListener('pointerdown', (event) => {
    if (event.pointerType === 'mouse') return;
    pointerStartX = event.clientX;
    isPointerTracking = true;
    notebook.setPointerCapture?.(event.pointerId);
  });

  notebook?.addEventListener('pointerup', (event) => {
    if (!isPointerTracking) return;
    isPointerTracking = false;
    const distance = event.clientX - pointerStartX;
    if (Math.abs(distance) < 48) return;
    suppressClick = true;
    showPage(current + (distance < 0 ? 1 : -1));
    window.setTimeout(() => { suppressClick = false; }, 0);
  });

  notebook?.addEventListener('pointercancel', () => { isPointerTracking = false; });
  notebook?.addEventListener('click', (event) => {
    if (!suppressClick) return;
    event.preventDefault();
    event.stopPropagation();
    suppressClick = false;
  }, true);

  twoPageSpread.addEventListener('change', () => {
    if (twoPageSpread.matches) {
      if (current > 0) current = Math.min(current - 1, leaves.length - 1);
      setLeftPage(current);
    } else {
      setMobilePage(current);
    }
    updateControls();
  });
  setLeftPage(current);
  updateControls();
</script>
