---
import BaseLayout from '../layouts/BaseLayout.astro';
import WorkbenchNav from './WorkbenchNav.astro';
import FooterWorkbench from '../../components/FooterWorkbench';
import StickyBooking from '../../components/StickyBooking';
import WorkbenchIcon from './WorkbenchIcon.astro';
import { serviceDetails } from '../data/services';
import '../styles/workbench.css';
import '../styles/service-detail.css';

type ServiceDetail = typeof serviceDetails[keyof typeof serviceDetails];
import type { SiteLocale } from '../utils/i18n';

interface Props {
  service: ServiceDetail;
  canonical: string;
  locale?: SiteLocale;
  alternates?: { en: string; bm: string };
}

const { service, canonical, locale = 'en', alternates } = Astro.props;
const isBm = locale === 'bm';
const whatsapp = isBm
  ? 'https://wa.me/60147533499?text=Salam%20HaikaiTech%2C%20saya%20ingin%20berbincang%20tentang%20projek.'
  : 'https://wa.me/60147533499?text=Hi%20HaikaiTech!%20I%27d%20like%20to%20discuss%20a%20project.';
---

<BaseLayout title={service.pageTitle} description={service.pageDescription} canonical={canonical} locale={locale} alternates={alternates}>
  <div class="workbench wb-detail-site bg-paper bg-grid-pattern">
    <WorkbenchNav locale={locale} />
    <main class="sd-main">
      <section class="sd-hero" aria-labelledby="service-detail-title">
        <div class="sd-hero-copy">
          <nav class="sd-breadcrumb" aria-label="Breadcrumb">
            <a href={isBm ? '/bm/' : '/'}>{isBm ? 'Laman Utama' : 'Home'}</a><span aria-hidden="true">/</span><a href={isBm ? '/bm/services/' : '/services/'}>{isBm ? 'Servis' : 'Services'}</a><span aria-hidden="true">/</span><span>{service.eyebrow.split(' / ')[0]}</span>
          </nav>
          <p class="wb-eyebrow sd-eyebrow"><WorkbenchIcon name={service.icon} size={18} />{service.eyebrow}</p>
          <h1 id="service-detail-title">{service.title.split('\n').map((line) => <span>{line}</span>)}</h1>
          <p class="sd-hero-description">{service.description}</p>
          <div class="sd-hero-actions">
            <a class="wb-button wb-button--painted" href={whatsapp} target="_blank" rel="noopener noreferrer"><span>{isBm ? 'Mulakan perbualan' : 'Start a conversation'}</span></a>
            <a class="wb-button wb-secondary" href={isBm ? '/bm/#projects' : '/#projects'}><span>{isBm ? 'Lihat hasil kerja' : 'See the work'}</span></a>
          </div>
          <p class="sd-hero-note">{service.heroNote}</p>
        </div>
        <div class="sd-hero-visual" aria-hidden="true">
          <slot name="visual" />
        </div>
      </section>

      <div class="sd-content">
        <slot name="content" />
      </div>

      <section class="sd-cta" aria-labelledby="service-cta-title">
        <div>
          <p class="wb-eyebrow">{isBm ? 'Langkah seterusnya' : 'Next useful step'}</p>
          <h2 id="service-cta-title">{isBm ? <>Bawa perkara yang rumit itu.<br /><em>Kita susun bersama.</em></> : <>Bring the messy bit.<br /><em>We’ll map it out.</em></>}</h2>
        </div>
        <div class="sd-cta-copy">
          <p>{isBm ? 'Beritahu kami kerja yang mengambil terlalu banyak masa, kehilangan maklumat penting atau memerlukan kedai dalam talian yang lebih sesuai. Kami akan cadangkan langkah seterusnya yang praktikal.' : 'Tell us what currently takes too much time, loses too much context or needs a better storefront. We’ll reply with a practical next step.'}</p>
          <div class="sd-cta-actions">
            <a class="wb-button wb-button--painted" href={whatsapp} target="_blank" rel="noopener noreferrer"><span>{isBm ? 'Hubungi melalui WhatsApp' : 'Chat on WhatsApp'}</span></a>
            <a class="sd-text-link" href={isBm ? 'mailto:hq@haikaitech.my?subject=Pertanyaan%20projek' : 'mailto:hq@haikaitech.my?subject=Project%20enquiry'}>{isBm ? 'E-mel' : 'Email'} hq@haikaitech.my</a>
          </div>
        </div>
      </section>
    </main>
    <FooterWorkbench locale={locale} />
    <StickyBooking client:load locale={locale} />
  </div>
</BaseLayout>
