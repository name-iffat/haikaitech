---
import { Image } from 'astro:assets';
import hssDesktopImg from '../assets/projects/hss-wireless-cctv-desktop.png';
import workforceDemoImg from '../assets/projects/mze-workforce-demo.png';
import aaBurgerImg from '../assets/projects/aaburger-kiosk-desktop.png';
import cityThreeImg from '../assets/projects/citythree-desktop.png';
import kopiTebuImg from '../assets/projects/kopitebu-desktop.png';
import { PROJECTS } from '../../constants';

const featuredProjects = [
  {
    id: 'mze',
    name: 'MZE Worker System',
    type: 'System',
    status: 'demo',
    href: 'https://mzdemo.haikaitech.my/',
    image: workforceDemoImg,
    alt: 'MZE Worker System workforce management dashboard in demo mode',
    attachment: 'pin',
  },
  {
    id: 'hss',
    name: 'HSS Wireless CCTV',
    type: 'Website',
    status: 'live',
    href: 'https://wirelesscctv.com.my/',
    image: hssDesktopImg,
    alt: 'HSS Wireless CCTV desktop website homepage',
    attachment: 'tape',
  },
  {
    id: 'aaburger',
    name: 'AA Burger Kiosk',
    type: 'Ordering',
    status: 'live',
    href: 'https://aaburger.haikaitech.my/',
    image: aaBurgerImg,
    alt: 'AA Burger Kiosk ordering interface',
    sticker: 'Order flow',
  },
  {
    id: 'citythree',
    name: 'CityThree',
    type: 'Website',
    status: 'live',
    href: 'https://citythree.my/',
    image: cityThreeImg,
    alt: 'CityThree desktop website homepage',
    attachment: 'pin',
  },
  {
    id: 'kopitebu',
    name: 'Kopi Tebu',
    type: 'Website',
    status: 'live',
    href: 'https://kopitebu-website.pages.dev/',
    image: kopiTebuImg,
    alt: 'Kopi Tebu desktop website homepage',
  },
];

const archiveProjects = PROJECTS.map((project) => ({
  ...project,
  name: project.name,
  status: project.status,
  href: project.link,
}));
---

<section id="projects" class="workbench wb-selected-work" aria-labelledby="selected-work-title">
  <header class="wb-selected-head">
    <div>
      <p class="wb-eyebrow">Selected work</p>
      <h2 id="selected-work-title">Useful things.<br />Shipped.</h2>
    </div>
    <p class="wb-selected-intro">Five recent builds, from public-facing sites to an operational system. Each screen is real work, not a placeholder.</p>
  </header>

  <div class="wb-work-wall" aria-label="Five recent HaikaiTech projects">
    {featuredProjects.map((project, index) => (
      <figure class={`wb-project-sheet wb-project-sheet--${project.id}`}>
        {project.id === 'hss' && (
          <span class="wb-project-sheet__note" aria-hidden="true">
            real work, in the field
            <svg viewBox="0 0 70 56" fill="none"><path d="M4 7c11 3 40 7 55 34m0 0-18-4m18 4-7-17" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" /></svg>
          </span>
        )}
        {project.attachment === 'tape' && <span class="wb-project-sheet__tape" aria-hidden="true"></span>}
        {project.attachment === 'pin' && <span class="wb-pin wb-project-sheet__pin" aria-hidden="true"></span>}
        {project.sticker && <span class="wb-project-sheet__sticker" aria-hidden="true">{project.sticker}</span>}
        <Image src={project.image} alt={project.alt} loading={index === 0 ? 'eager' : 'lazy'} sizes="(max-width: 1023px) calc(100vw - 48px), 66vw" />
        <figcaption>
          <a href={project.href} target="_blank" rel="noopener noreferrer" aria-label={`Open ${project.name}`}>
            <span>
              <b>{project.name}</b>
              <small class={`wb-project-sheet__status wb-project-sheet__status--${project.status}`}>{project.type} / {project.status}</small>
            </span>
            <span class="wb-project-sheet__visit">View</span>
          </a>
          <span aria-hidden="true">{String(index + 1).padStart(2, '0')} / 05</span>
        </figcaption>
      </figure>
    ))}
  </div>

  <section class="wb-archive" aria-labelledby="archive-title">
    <header class="wb-archive-head">
      <div><p class="wb-eyebrow">More from the workshop / {archiveProjects.length} projects</p><h3 id="archive-title">Explore the rest.</h3></div>
      <div class="wb-archive-controls"><button type="button" data-direction="-1" aria-label="Previous projects" aria-controls="archive-rail">←</button><button type="button" data-direction="1" aria-label="Next projects" aria-controls="archive-rail">→</button></div>
    </header>
    <ul id="archive-rail" class="wb-archive-rail" tabindex="0" aria-label="Previous projects and demos; scroll horizontally">
      {archiveProjects.map((project) => (
        <li class="wb-archive-sheet">
          <a class="wb-archive-image" href={`/projects/${project.id}/`}><img src={project.image} width="600" height="450" alt={`${project.name} website preview`} loading="lazy" /></a>
          <div class="wb-archive-copy">
            <small class={`wb-project-sheet__status wb-project-sheet__status--${project.status}`}>{project.status}</small>
            <h4><a href={`/projects/${project.id}/`}>{project.name}</a></h4>
            <p>{project.purpose}</p>
            <div class="wb-archive-tools"><h5>Tech, tools &amp; toys</h5><ul>{project.skills.map(skill => <li>{skill}</li>)}</ul></div>
            <a class="wb-archive-visit" href={project.href} target="_blank" rel="noopener noreferrer">Visit project</a>
          </div>
        </li>
      ))}
    </ul>
    <p class="wb-archive-hint">Scroll or swipe to explore all {archiveProjects.length} projects</p>
  </section>
</section>

<script>
  const rail = document.querySelector<HTMLElement>('#archive-rail');
  const buttons = document.querySelectorAll<HTMLButtonElement>('.wb-archive-controls button');
  if (rail) {
    const update = () => buttons.forEach(button => {
      button.disabled = button.dataset.direction === '-1' ? rail.scrollLeft <= 2 : rail.scrollLeft >= rail.scrollWidth - rail.clientWidth - 2;
    });
    buttons.forEach(button => button.addEventListener('click', () => {
      const step = (rail.firstElementChild?.getBoundingClientRect().width ?? rail.clientWidth) + 24;
      rail.scrollBy({ left: Number(button.dataset.direction) * step, behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'instant' : 'smooth' });
    }));
    rail.addEventListener('scroll', update, { passive: true });
    new ResizeObserver(update).observe(rail);
    update();
  }
</script>
