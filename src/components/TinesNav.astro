<script>
  import { track } from '../../components/track';

  const header = document.querySelector<HTMLElement>('[data-tines-header]');
  const onScroll = () => {
    if (!header) return;
    header.dataset.scrolled = window.scrollY > 24 ? 'true' : 'false';
  };
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  const mobileMenu = document.querySelector<HTMLDetailsElement>('.tines-mobile-menu');
  mobileMenu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      if (mobileMenu) mobileMenu.open = false;
    });
  });

  const dropdownItems = Array.from(document.querySelectorAll<HTMLElement>('[data-nav-dropdown]'));
  let closeTimer: number | undefined;

  const setOpen = (target: HTMLElement | null) => {
    window.clearTimeout(closeTimer);
    dropdownItems.forEach((item) => {
      const open = item === target;
      item.dataset.open = open ? 'true' : 'false';
      const trigger = item.querySelector<HTMLAnchorElement>('.tines-nav__link');
      if (trigger) trigger.setAttribute('aria-expanded', open ? 'true' : 'false');
    });
  };

  const scheduleClose = () => {
    window.clearTimeout(closeTimer);
    closeTimer = window.setTimeout(() => setOpen(null), 160);
  };

  dropdownItems.forEach((item) => {
    const panel = item.querySelector<HTMLElement>('.ht-mega-wrap');
    item.addEventListener('mouseenter', () => setOpen(item));
    item.addEventListener('mouseleave', scheduleClose);
    panel?.addEventListener('mouseenter', () => setOpen(item));
    panel?.addEventListener('mouseleave', scheduleClose);
    item.addEventListener('focusin', () => setOpen(item));
    item.addEventListener('focusout', (event: FocusEvent) => {
      const next = event.relatedTarget as Node | null;
      if (!next || !item.contains(next)) {
        if (item.dataset.open === 'true') setOpen(null);
      }
    });
  });

  document.addEventListener('keydown', (event: KeyboardEvent) => {
    if (event.key === 'Escape') {
      setOpen(null);
      if (mobileMenu?.open) mobileMenu.open = false;
    }
  });

  document.querySelectorAll<HTMLAnchorElement>('[data-tines-event]').forEach((el) => {
    el.addEventListener('click', () => track('cta_clicked', el.dataset.tinesEvent));
  });
</script>
