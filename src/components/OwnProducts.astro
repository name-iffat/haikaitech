---
import { Image } from 'astro:assets';
import hermesCover from '../assets/guide/hermes-ebook-cover.jpg';
import invoiceArt from '../assets/concept-decorations/refined/toolkit-invoice.png';
import quotationArt from '../assets/concept-decorations/refined/toolkit-quotation.png';
import receiptArt from '../assets/concept-decorations/refined/toolkit-receipt.png';

interface Props {
  posts?: any[];
}

const { posts = [] } = Astro.props;

const formatTag = (raw?: string) => (raw ?? 'Field note').replace(/-/g, ' ');

const toolkitTools = [
  {
    name: 'Invoice Generator',
    desc: 'PDF invoices with auto numbering',
    image: invoiceArt,
    url: 'https://invoice.haikaitech.my',
  },
  {
    name: 'Quotation Builder',
    desc: 'Itemised quotes that convert to invoices',
    image: quotationArt,
    url: 'https://invoice.haikaitech.my/?type=quotation',
  },
  {
    name: 'Receipt Maker',
    desc: 'Numbered payment receipts linked back',
    image: receiptArt,
    url: 'https://invoice.haikaitech.my/?type=receipt',
  },
];

const fallbackNotes = [
  {
    title: 'How much does a Malaysian business website cost?',
    tag: 'Pricing',
    href: '/blog/',
  },
  {
    title: 'What makes visitors message you on WhatsApp',
    tag: 'Conversion',
    href: '/blog/',
  },
  {
    title: 'Practical automation for small SME teams',
    tag: 'Workflows',
    href: '/blog/',
  },
];

const noteTones = ['cobalt', 'mint', 'amber'] as const;

const fieldNotes = (
  posts.length > 0
    ? posts.slice(0, 3).map((post) => ({
        title: post.data.title,
        tag: formatTag(post.data.tags?.[0]),
        href: `/blog/${post.id}/`,
      }))
    : fallbackNotes
).map((note, idx) => ({
  ...note,
  tone: noteTones[idx % noteTones.length],
}));
---

<section class="ht-workshop" aria-labelledby="own-products-title">
  <div class="tines-container">
    <header class="ht-workshop__head">
      <div class="ht-workshop__head-copy">
        <p class="ht-workshop__eyebrow">
          <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M8 1.5l1.6 4.4L14 7.5l-4.4 1.6L8 13.5l-1.6-4.4L2 7.5l4.4-1.6L8 1.5z" />
          </svg>
          <span>Workshop resources &amp; free tools</span>
        </p>
        <h2 id="own-products-title" class="ht-workshop__title">
          Practical guides &amp; free tools <span>for Malaysian businesses.</span>
        </h2>
        <p class="ht-workshop__sub">
          Field-tested playbooks, blog notes, and browser-based SME tools built in our Penang workshop.
        </p>
      </div>
      <a class="ht-workshop__all-btn" href="/toolkit/">
        <span>Open free toolkit</span>
        <span aria-hidden="true">&#8594;</span>
      </a>
    </header>

    <div class="ht-workshop__grid">
      <!-- Area 1: Hermes Desktop Guide (7 cols desktop) -->
      <article class="ht-workshop__panel ht-workshop__panel--hermes">
        <div class="ht-workshop__meta">
          <p class="ht-workshop__kicker">
            <svg class="ht-workshop__kicker-icon" width="15" height="15" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M2.5 3.5h4.2c.7 0 1.3.5 1.3 1.2v8c-.5-.5-1.1-.7-1.8-.7H2.5v-8.5z" />
              <path d="M13.5 3.5H9.3c-.7 0-1.3.5-1.3 1.2v8c.5-.5 1.1-.7 1.8-.7h3.7v-8.5z" />
            </svg>
            <span>Ebook · 218 pages</span>
          </p>
          <span class="ht-workshop__status">
            <i aria-hidden="true"></i>
            From RM24.65 · Gumroad
          </span>
        </div>

        <h3>Your Own AI Business Assistant</h3>
        <p class="ht-workshop__lead">
          A practical illustrated guide to Hermes Desktop: client messages, research notes, invoice and email drafts with you in control.
        </p>

        <div class="ht-workshop__cover">
          <Image
            src={hermesCover}
            width={760}
            widths={[480, 760]}
            sizes="(max-width: 1080px) 92vw, 620px"
            format="webp"
            quality={86}
            alt="Your Own AI Business Assistant: A Practical Guide to Getting Started with Hermes Desktop, by Iffat Haikal"
            loading="lazy"
            decoding="async"
          />
        </div>

        <div class="ht-workshop__actions">
          <a class="ht-workshop__cta" href="/hermes-guide/">
            <span>Read Hermes guide</span>
            <span aria-hidden="true">&#8594;</span>
          </a>
          <a
            class="ht-workshop__text-link"
            href="https://haikaitech.gumroad.com/l/hermes-desktop-ebook-guide"
            target="_blank"
            rel="noopener noreferrer"
          >
            Buy on Gumroad &#8599;
          </a>
        </div>
      </article>

      <!-- Area 2: Field Notes / Blog Tips (5 cols desktop, borderless warm editorial ledger + crisp white inset sheet) -->
      <article class="ht-workshop__panel ht-workshop__panel--notes">
        <div class="ht-workshop__meta ht-workshop__panel-head">
          <p class="ht-workshop__kicker">
            <svg class="ht-workshop__kicker-icon" width="15" height="15" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="3" y="2.2" width="10" height="11.6" rx="1.8" />
              <path d="M5.6 5.5h4.8M5.6 8h4.8M5.6 10.5h3" />
            </svg>
            <span>Field notes · Blog tips</span>
          </p>
          <a class="ht-workshop__text-link" href="/blog/">All field notes &#8594;</a>
        </div>

        <div class="ht-workshop__notes-top">
          <div>
            <h3>Practical tips before you build.</h3>
            <p>
              Straight breakdowns on website cost, SEO/AEO, WhatsApp conversion, and automation.
            </p>
          </div>

          <svg class="ht-workshop__spot-art" width="48" height="48" viewBox="0 0 64 64" fill="none" aria-hidden="true">
            <ellipse cx="32" cy="57" rx="20" ry="3.2" fill="#16202A" fill-opacity="0.14" />
            <path d="M40 16c1-6 6-10 12-9-1 6-6 10-12 9Z" fill="#22C58B" stroke="#16202A" stroke-width="1.8" stroke-linejoin="round" />
            <path d="M41.5 15.2c3-2.5 5.5-4.3 8.5-5.6" stroke="#16202A" stroke-width="1.3" stroke-linecap="round" />
            <path d="M12 20c0-2.2 1.8-4 4-4h16v32H16c-2.2 0-4 1.2-4 3V20Z" fill="#FAF8F3" stroke="#16202A" stroke-width="1.8" stroke-linejoin="round" />
            <path d="M52 20c0-2.2-1.8-4-4-4H32v32h16c2.2 0 4 1.2 4 3V20Z" fill="#FAF8F3" stroke="#16202A" stroke-width="1.8" stroke-linejoin="round" />
            <path d="M22 14h6v14l-3-2.4-3 2.4V14Z" fill="#F4D35E" stroke="#16202A" stroke-width="1.7" stroke-linejoin="round" />
            <path d="M17 31h10M17 37h10M37 25h10M37 31h10M37 37h8" stroke="#1368E6" stroke-width="1.7" stroke-linecap="round" />
          </svg>
        </div>

        <div class="ht-workshop__sheet">
          <div class="ht-workshop__sheet-bar" aria-hidden="true">
            <span class="ht-workshop__sheet-tab ht-workshop__sheet-tab--active">
              <svg width="13" height="13" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                <path d="M8 2l1.4 3.8L13 7.2l-3.6 1.4L8 12.4 6.6 8.6 3 7.2l3.6-1.4L8 2z" />
              </svg>
              <span>Field notes</span>
              <span class="ht-workshop__sheet-count">{fieldNotes.length}</span>
            </span>
            <span class="ht-workshop__sheet-tab">SME blog</span>
          </div>
          <div class="ht-workshop__sheet-col" aria-hidden="true">Latest notes</div>
          <div class="ht-workshop__note-list">
            {fieldNotes.map((note) => (
              <a class="ht-workshop__note-row" href={note.href}>
                <span class={`ht-workshop__note-dots ht-workshop__note-dots--${note.tone}`} aria-hidden="true">
                  <i></i><i></i><i></i><i></i>
                </span>
                <span class="ht-workshop__note-copy">
                  <strong>{note.title}</strong>
                  <small>{note.tag}</small>
                </span>
                <span class="ht-workshop__note-arrow" aria-hidden="true">&#8594;</span>
              </a>
            ))}
          </div>
        </div>
      </article>

      <!-- Area 3: Free 2026 Website Lead-Gen Guide (5 cols desktop) -->
      <article class="ht-workshop__panel ht-workshop__panel--guide">
        <div class="ht-workshop__guide-top">
          <div>
            <p class="ht-workshop__kicker">
              <svg class="ht-workshop__kicker-icon" width="15" height="15" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M13.8 2.4L7.2 9" />
                <path d="M13.8 2.4L9.5 14l-2.3-5-5-2.3 11.6-4.3z" />
              </svg>
              <span>Free PDF · 2026</span>
            </p>
            <h3>2026 Website Lead-Gen Guide</h3>
            <p>
              Where Malaysian enquiries start, channel RM costs, reply-speed data, and copy-paste WhatsApp scripts.
            </p>
          </div>

          <svg class="ht-workshop__guide-art" width="56" height="56" viewBox="0 0 64 64" fill="none" aria-hidden="true">
            <ellipse cx="32" cy="57" rx="18" ry="3" fill="#16202A" fill-opacity="0.14" />
            <path d="M16 18c-3-5 1-11 7-11 1 5-2 10-7 11Z" fill="#22C58B" stroke="#16202A" stroke-width="1.7" stroke-linejoin="round" />
            <path d="M16.5 16c1.5-2.8 3.2-5 5.2-6.8" stroke="#16202A" stroke-width="1.2" stroke-linecap="round" />
            <path d="M46 19c2-5 7-9 12-7-2 5-6 8-12 7Z" fill="#F4D35E" stroke="#16202A" stroke-width="1.7" stroke-linejoin="round" />
            <path d="M47.5 17.8c2.6-1.5 5-2.5 7.5-3.2" stroke="#16202A" stroke-width="1.2" stroke-linecap="round" />
            <rect x="14" y="14" width="32" height="40" rx="5" fill="#FAF8F3" stroke="#16202A" stroke-width="1.8" />
            <circle cx="24" cy="45" r="4.2" fill="#F28466" stroke="#16202A" stroke-width="1.5" />
            <path d="M21 23h18M21 29h14M21 35h10" stroke="#16202A" stroke-width="1.6" stroke-linecap="round" />
            <path d="m34 38 18-8-8 18-3-6-7-4Z" fill="#1368E6" stroke="#16202A" stroke-width="1.7" stroke-linejoin="round" />
          </svg>
        </div>

        <ol class="ht-workshop__guide-list">
          <li>
            <span class="ht-workshop__guide-num ht-workshop__guide-num--blue">01</span>
            <span>
              <strong>Channel costs compared (RM)</strong>
              <small>Google, Meta, WhatsApp &amp; email</small>
            </span>
          </li>
          <li>
            <span class="ht-workshop__guide-num ht-workshop__guide-num--mint">02</span>
            <span>
              <strong>Reply-speed conversion data</strong>
              <small>Why the first hour wins the lead</small>
            </span>
          </li>
          <li>
            <span class="ht-workshop__guide-num ht-workshop__guide-num--gold">03</span>
            <span>
              <strong>WhatsApp reply scripts</strong>
              <small>Copy-paste follow-up templates</small>
            </span>
          </li>
        </ol>

        <div class="ht-workshop__guide-foot">
          <a class="ht-workshop__cta" href="/guide/">
            <span>Get free PDF guide</span>
            <span aria-hidden="true">&#8594;</span>
          </a>
        </div>
      </article>

      <!-- Area 4: 3 Free SME Toolkit Tools from /toolkit/ (7 cols desktop) -->
      <article class="ht-workshop__panel ht-workshop__panel--toolkit">
        <div class="ht-workshop__meta">
          <p class="ht-workshop__kicker">
            <svg class="ht-workshop__kicker-icon" width="15" height="15" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="2.2" y="2.2" width="4.8" height="4.8" rx="1.2" />
              <rect x="9" y="2.2" width="4.8" height="4.8" rx="1.2" />
              <rect x="2.2" y="9" width="4.8" height="4.8" rx="1.2" />
              <rect x="9" y="9" width="4.8" height="4.8" rx="1.2" />
            </svg>
            <span>Free SME Toolkit · RM0</span>
          </p>
          <a class="ht-workshop__text-link" href="/toolkit/">Browse toolkit &#8594;</a>
        </div>

        <div class="ht-workshop__toolkit-top">
          <div>
            <h3>Less paperwork. Three free tools.</h3>
            <p>
              Instant browser-based PDF generators for Malaysian SMEs, ready to use with no signup.
            </p>
          </div>

          <svg class="ht-workshop__spot-art" width="48" height="48" viewBox="0 0 64 64" fill="none" aria-hidden="true">
            <ellipse cx="32" cy="56" rx="17" ry="3" fill="#16202A" fill-opacity="0.14" />
            <circle cx="32" cy="29" r="18" fill="#F4D35E" stroke="#16202A" stroke-width="1.8" />
            <circle cx="32" cy="29" r="8.5" fill="#FAF8F3" stroke="#16202A" stroke-width="1.8" />
            <path d="M40 13.5A17.5 17.5 0 0 1 49.5 29c0 8.2-5.7 15.1-13.4 17l-2.4-6.4A11 11 0 0 0 42.5 29c0-4.4-2.5-8.2-6.2-10l3.7-5.5Z" fill="#9AB8FA" stroke="#16202A" stroke-width="1.8" stroke-linejoin="round" />
            <path d="M21 15l3.5 5.4M43 43l-3.5-5.4M14 29h6.5" stroke="#16202A" stroke-width="1.6" stroke-linecap="round" />
          </svg>
        </div>

        <div class="ht-workshop__tool-columns">
          {toolkitTools.map((tool) => (
            <a
              class="ht-workshop__tool-col"
              href={tool.url}
              target="_blank"
              rel="noopener noreferrer"
            >
              <div class="ht-workshop__tool-art">
                <Image
                  src={tool.image}
                  width={300}
                  format="webp"
                  alt=""
                  loading="lazy"
                  decoding="async"
                />
              </div>
              <h4>{tool.name}</h4>
              <p>{tool.desc}</p>
              <span class="ht-workshop__tool-open">Open tool &#8599;</span>
            </a>
          ))}
        </div>
      </article>
    </div>

    <p class="ht-workshop__foot">
      Side experiment in progress: BearSplit bill-splitting prototype · <a href="/bearsplit/">Explore BearSplit &#8594;</a>
    </p>
  </div>
</section>
