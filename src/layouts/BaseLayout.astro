---
interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  noindex?: boolean;
}

import '../styles/global.css';

const { title = 'HAIKAITECH SOLUTIONS | Software Engineering Studio Malaysia', description = 'HAIKAITECH SOLUTIONS — registered software engineering studio in Malaysia. We build custom web apps, dashboards, and interactive systems with React, .NET, and Unity. Chat on WhatsApp for a fast reply.', canonical = 'https://haikaitech.my/', noindex = false } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {noindex && <meta name="robots" content="noindex, nofollow" />}
  <link rel="icon" type="image/png" href="/favicon.png" />
  <link rel="apple-touch-icon" href="/favicon.png" />
  <!-- Open Graph -->
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:type" content="website" />
  <meta property="og:image" content="https://haikaitech.my/og-image.png" />
  <meta name="twitter:card" content="summary" />
  <!-- JSON-LD Schema -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Person",
    "name": "Iffat Haikal",
    "url": "https://haikaitech.my/",
    "jobTitle": "Software Engineer",
    "description": "Freelance software engineer building web apps, dashboards, and interactive systems.",
    "sameAs": [
      "https://github.com/name-iffat",
      "https://www.linkedin.com/in/iffathaikal/"
    ]
  }
  </script>
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "HaikaiTech",
    "url": "https://haikaitech.my/",
    "description": "Freelance software engineering portfolio — React, .NET, Unity, and custom web development."
  }
  </script>
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": "HaikaiTech Solutions",
    "legalName": "HaikaiTech Solutions",
    "url": "https://haikaitech.my/",
    "email": "hq@haikaitech.my",
    "foundingDate": "2026",
    "identifier": "202603149868",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "2-U, Jalan Sultan Azlan Shah, Bandar Bayan Baru",
      "addressLocality": "Bayan Lepas",
      "addressRegion": "Penang",
      "postalCode": "11950",
      "addressCountry": "MY"
    },
    "sameAs": [
      "https://github.com/name-iffat",
      "https://www.linkedin.com/in/iffathaikal/"
    ],
    "knowsAbout": ["Web development", "React", "Astro", ".NET", "Blazor", "C#", "Unity", "SQL", "Business dashboards", "Custom web apps"]
  }
  </script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link
    rel="preload"
    as="style"
    href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&family=Patrick+Hand&family=VT323&display=swap"
    onload="this.onload=null;this.rel='stylesheet'"
  >
  <noscript>
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&family=Patrick+Hand&family=VT323&display=swap"
      rel="stylesheet">
  </noscript>
  <!-- GA4 Measurement Protocol beacon (no gtag.js) -->
  <script>
    (function () {
      function getClientId() {
        try {
          var m = document.cookie.match(/(?:^|;\s*)_ga=GA\d\.\d+\.([\d.]+)/);
          if (m) return m[1];
        } catch (e) {}
        try {
          var id = localStorage.getItem('hktk_cid');
          if (!id) {
            id = Math.random().toString(36).slice(2) + '.' + Date.now().toString(36);
            localStorage.setItem('hktk_cid', id);
          }
          return id;
        } catch (e) {
          return 'XXXXXXXXXXXXXXX.' + Date.now();
        }
      }

      var clientId = getClientId();
      var sessionId = null;
      try {
        sessionId = sessionStorage.getItem('hktk_sid');
        if (!sessionId) {
          sessionId = Date.now().toString(36);
          sessionStorage.setItem('hktk_sid', sessionId);
        }
      } catch (e) {
        sessionId = Date.now().toString(36);
      }

      function send(name, params) {
        try {
          var payload = {
            client_id: clientId,
            events: [{
              name: name,
              params: Object.assign({
                session_id: sessionId,
                page_location: window.location.href,
                page_title: document.title,
                page_referrer: document.referrer
              }, params || {})
            }]
          };
          var url = '/api/track';
          var body = new Blob([JSON.stringify(payload)], { type: 'application/json' });
          if (navigator.sendBeacon) {
            navigator.sendBeacon(url, body);
          } else {
            fetch(url, { method: 'POST', keepalive: true, body: body });
          }
        } catch (e) {}
      }

      window.gtag = function (cmd, name, params) {
        if (cmd === 'event' && typeof name === 'string') {
          send(name, params);
        }
      };

      if (document.readyState === 'complete') {
        send('page_view');
      } else {
        window.addEventListener('load', function () { send('page_view'); }, { once: true });
      }
    })();
  </script>
</head>
<body>
  <slot />
  <div class="paper-texture"></div>
</body>
</html>
