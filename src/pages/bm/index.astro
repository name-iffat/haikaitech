---
import { getPublicPosts } from '../../lib/content/posts';
import BaseLayout from '../../layouts/BaseLayout.astro';
import TinesNav from '../../components/TinesNav.astro';
import TinesHero from '../../components/TinesHero.astro';
import TinesEditorialAndPillars from '../../components/TinesEditorialAndPillars.astro';
import TinesBentoAndProof from '../../components/TinesBentoAndProof.astro';
import SelectedWorkSection from '../../components/SelectedWorkSection.astro';
import PricingWorkbench from '../../components/PricingWorkbench.astro';
import InsightsNotebook from '../../components/InsightsNotebook.astro';
import ContactSection from '../../../components/Sections/ContactWorkbench';
import FooterWorkbench from '../../../components/FooterWorkbench';
import StickyBooking from '../../../components/StickyBooking';
import '../../styles/workbench.css';
import '../../styles/tines-home.css';
import MetaPixel from '../../components/MetaPixel.astro';
import LenisScroll from '../../components/LenisScroll.astro';

const blogPosts = (await getPublicPosts())
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 4);

const alternates = { en: 'https://haikaitech.my/', bm: 'https://haikaitech.my/bm/' };
---

<BaseLayout
  locale="bm"
  title="HaikaiTech | Laman Web & Sistem Perniagaan Malaysia"
  description="HaikaiTech membina laman web, sistem perniagaan, automasi dan produk digital untuk perniagaan di Malaysia. Bincang projek anda melalui WhatsApp."
  canonical="https://haikaitech.my/bm/"
  alternates={alternates}
>
  <div class="tines-home min-h-screen relative selection:bg-violet-200 selection:text-slate-900">
    <TinesNav locale="bm" />
    <main>
      <TinesHero locale="bm" />
      <MetaPixel locale="bm" inlineChoice />
      <TinesEditorialAndPillars locale="bm" />
      <TinesBentoAndProof locale="bm" />
      <SelectedWorkSection locale="bm" />
      <div id="pricing" class="scroll-mt-24"><PricingWorkbench locale="bm" /></div>
      <InsightsNotebook locale="bm" posts={blogPosts} />
      <div id="start" class="scroll-mt-28"><ContactSection client:load locale="bm" /></div>
    </main>
    <FooterWorkbench client:load locale="bm" />
    <StickyBooking client:load locale="bm" />
    <LenisScroll />
  </div>
</BaseLayout>
