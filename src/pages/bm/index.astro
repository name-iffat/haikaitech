---
import { getImage } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import WorkbenchNav from '../../components/WorkbenchNav.astro';
import TrustProof from '../../components/TrustProof.astro';
import WorkbenchHero from '../../../components/Sections/WorkbenchHero';
import SelectedWorkSection from '../../components/SelectedWorkSection.astro';
import ServicesWorkbench from '../../components/ServicesWorkbench.astro';
import AboutWorkbench from '../../components/AboutWorkbench.astro';
import InsightsNotebook from '../../components/InsightsNotebook.astro';
import ContactSection from '../../../components/Sections/ContactWorkbench';
import FooterWorkbench from '../../../components/FooterWorkbench';
import StickyBooking from '../../../components/StickyBooking';
import '../../styles/workbench.css';

import workforceDemoImg from '../../assets/projects/mze-workforce-demo.png';
import fuzzfloorMobileImg from '../../assets/projects/fuzzfloor-mobile.png';
import hssDesktopImg from '../../assets/projects/hss-wireless-cctv-desktop.png';
import heroTapeImg from '../../assets/concept-decorations/refined/hero-masking-tape.webp';
import heroPinImg from '../../assets/concept-decorations/refined/hero-clay-pin.webp';

const heroWebsite = await getImage({ src: hssDesktopImg, width: 1280, format: 'webp' });
const heroFuzzfloor = await getImage({ src: fuzzfloorMobileImg, width: 600, format: 'webp' });
const heroDashboard = await getImage({ src: workforceDemoImg, width: 1200, format: 'webp' });
const heroTape = await getImage({ src: heroTapeImg, width: 360, format: 'webp' });
const heroPin = await getImage({ src: heroPinImg, width: 120, format: 'webp' });
const blogPosts = (await getCollection('blog'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 4);

const alternates = { en: 'https://haikaitech.my/', bm: 'https://haikaitech.my/bm/' };
---

<BaseLayout
  locale="bm"
  title="HaikaiTech | Laman Web & Sistem Perniagaan Malaysia"
  description="HaikaiTech membina laman web, sistem perniagaan, automasi dan produk digital untuk perniagaan di Malaysia. Bincang projek anda melalui WhatsApp."
  canonical="https://haikaitech.my/bm/"
  alternates={alternates}
>
  <div class="min-h-screen relative font-sans bg-paper bg-grid-pattern selection:bg-yellow-200 selection:text-slate-900">
    <WorkbenchNav locale="bm" />
    <main class="bg-paper">
      <WorkbenchHero client:load locale="bm" websiteSrc={heroWebsite.src} fuzzfloorSrc={heroFuzzfloor.src} dashboardSrc={heroDashboard.src} tapeSrc={heroTape.src} pinSrc={heroPin.src} />
      <TrustProof locale="bm" />
      <SelectedWorkSection locale="bm" />
      <ServicesWorkbench locale="bm" />
      <AboutWorkbench locale="bm" />
      <InsightsNotebook locale="bm" posts={blogPosts} />
      <div id="start" class="scroll-mt-28"><ContactSection client:load locale="bm" /></div>
    </main>
    <FooterWorkbench client:load locale="bm" />
    <StickyBooking client:load locale="bm" />
  </div>
</BaseLayout>
