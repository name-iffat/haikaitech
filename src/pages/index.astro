---
import BaseLayout from '../layouts/BaseLayout.astro';
import TinesNav from '../components/TinesNav.astro';
import TinesHero from '../components/TinesHero.astro';
import TinesEditorialAndPillars from '../components/TinesEditorialAndPillars.astro';
import TinesBentoAndProof from '../components/TinesBentoAndProof.astro';
import '../styles/workbench.css';
import '../styles/tines-home.css';
import SelectedWorkSection from '../components/SelectedWorkSection.astro';
import IntegrationsHub from '../components/IntegrationsHub.astro';
import PricingWorkbench from '../components/PricingWorkbench.astro';
import OwnProducts from '../components/OwnProducts.astro';
import InsightsNotebook from '../components/InsightsNotebook.astro';
import ContactSection from '../../components/Sections/ContactWorkbench';
import FooterWorkbench from '../../components/FooterWorkbench';
import StickyBooking from '../../components/StickyBooking';
import { getPublicPosts } from '../lib/content/posts';
import MetaPixel from '../components/MetaPixel.astro';
import LenisScroll from '../components/LenisScroll.astro';

const blogPosts = (await getPublicPosts())
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 4);
---

<BaseLayout
  title="Web Design Penang & Selangor | Business Websites | HaikaiTech"
  description="Penang-based web studio building business websites, ecommerce and automation for SMEs in Penang, Selangor and across Malaysia. WhatsApp for a fast reply."
  canonical="https://haikaitech.my/"
  alternates={{ en: 'https://haikaitech.my/', bm: 'https://haikaitech.my/bm/' }}>
  <div class="tines-home min-h-screen relative selection:bg-violet-200 selection:text-slate-900">
    <TinesNav />
    <main>
      <TinesHero />
      <MetaPixel inlineChoice />
      <TinesEditorialAndPillars />
      <TinesBentoAndProof />
      <SelectedWorkSection />
      <IntegrationsHub />
      <div id="pricing" class="scroll-mt-24"><PricingWorkbench /></div>
      <OwnProducts posts={blogPosts.slice(0, 3)} />
      <InsightsNotebook posts={blogPosts} />
      <div id="start" class="scroll-mt-28"><ContactSection client:load /></div>
    </main>

    <FooterWorkbench client:load />

    <StickyBooking client:load />
    <LenisScroll />
  </div>
</BaseLayout>
