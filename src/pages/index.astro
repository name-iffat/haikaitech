---
import { getImage } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar';
import HeroSection from '../../components/Sections/HeroSection';
import ProjectsSection from '../../components/Sections/ProjectsSection';
import SkillsSection from '../../components/Sections/SkillsSection';
import AboutSection from '../../components/Sections/AboutSection';
import ContactSection from '../../components/Sections/ContactSection';
import StartProjectSection from '../../components/Sections/StartProjectSection';
import FooterSection from '../../components/FooterSection';
import NewsletterForm from '../../components/NewsletterForm';
import StickyBooking from '../../components/StickyBooking';
import { DoodleStar } from '../../components/Decorations';
import { PROJECTS } from '../../constants';
import { getCollection } from 'astro:content';

import murtajizImg from '../../src/assets/projects/al-murtajiz-travel.webp';
import bearsplitImg from '../../src/assets/projects/bear-split-waitlist.webp';
import hijrahImg from '../../src/assets/projects/hijrahalharamainhq.webp';
import dentexImg from '../../src/assets/projects/dentex-clinic.webp';
import tahuImg from '../../src/assets/projects/tahu-kripto.webp';
import pizzaImg from '../../src/assets/projects/rumahpizza.webp';
import clarityImg from '../../src/assets/projects/clarity-learncentre.webp';
import medinImg from '../../src/assets/projects/medin-fragrances.webp';
import avatarImg from '../../src/assets/projects/3D-me.webp';
import avsbinaImg from '../../src/assets/projects/avsbina.webp';
import adyumrahImg from '../../src/assets/projects/adyumrah.webp';
import fuzzfloorImg from '../../src/assets/projects/fuzzfloor.webp';
import atoneImg from '../../src/assets/projects/atone.webp';
import binamajuImg from '../../src/assets/projects/binamaju.webp';
import binaproImg from '../../src/assets/projects/binapro.webp';
import hawkerrewardsImg from '../../src/assets/projects/hawkerrewards.webp';

const projectImgMeta: Record<string, any> = {
  murtajiz: murtajizImg,
  bearsplit: bearsplitImg,
  hijrah: hijrahImg,
  dentex: dentexImg,
  tahu: tahuImg,
  pizza: pizzaImg,
  'clarity-learncentre': clarityImg,
  medin: medinImg,
  avsbina: avsbinaImg,
  adyumrah: adyumrahImg,
  fuzzfloor: fuzzfloorImg,
  atone: atoneImg,
  binamaju: binamajuImg,
  binapro: binaproImg,
  hawkerrewards: hawkerrewardsImg,
};

const projectImages: Record<string, string> = {};
for (const project of PROJECTS) {
  const img = projectImgMeta[project.id];
  if (img) {
    const optimized = await getImage({ src: img, width: 600, format: 'webp' });
    projectImages[project.id] = optimized.src;
  }
}

const heroAvatar = await getImage({ src: avatarImg, width: 400, format: 'webp' });

const blogPosts = (await getCollection('blog'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const formatPostDate = (date: Date) =>
  new Date(date).toLocaleDateString('en-GB', { month: 'short', year: 'numeric' });
---

<BaseLayout>
  <div class="min-h-screen relative font-sans bg-paper bg-grid-pattern selection:bg-yellow-200 selection:text-slate-900">
    <Navbar client:load />

    <main class="max-w-5xl mx-auto px-6 py-20 md:py-32 relative">
      <DoodleStar className="top-20 left-10 text-slate-300 animate-pulse hidden lg:block" />
      <DoodleStar className="top-40 right-20 text-blue-200 hidden lg:block" />
      <DoodleStar className="bottom-20 left-1/4 text-orange-200 hidden lg:block" />

      <HeroSection client:load avatarSrc={heroAvatar.src} />
      <ProjectsSection client:load projectImages={projectImages} />
      <SkillsSection />
      <AboutSection />
      <section class="relative py-16">
        <div class="flex items-end justify-between gap-4 mb-10">
          <div>
            <p class="font-mono text-xs text-slate-500 uppercase tracking-widest">Field Notes</p>
            <h2 class="mt-2 font-hand text-4xl md:text-5xl text-slate-800">Latest from the blog</h2>
          </div>
          <a href="/blog/" class="hidden sm:inline-flex items-center gap-2 font-mono text-sm text-blue-700 hover:gap-3 transition-all whitespace-nowrap">
            All posts →
          </a>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {blogPosts.map((p) => (
            <a
              href={`/blog/${p.id}/`}
              class="group block bg-white border border-slate-200 rounded-2xl p-6 shadow-[0_8px_30px_rgb(0,0,0,0.04)] hover:-translate-y-1 hover:shadow-[0_12px_40px_rgb(0,0,0,0.08)] transition-all"
            >
              <p class="font-mono text-xs text-slate-500 mb-3">{formatPostDate(p.data.pubDate)}</p>
              <h3 class="font-bold text-slate-800 group-hover:text-blue-700 transition-colors leading-snug">{p.data.title}</h3>
              <p class="mt-2 text-sm text-slate-500 line-clamp-2">{p.data.description}</p>
              <span class="mt-4 inline-flex items-center gap-2 font-mono text-sm text-blue-700 group-hover:gap-3 transition-all">Read →</span>
            </a>
          ))}
        </div>
      </section>
      <ContactSection client:load />
      <StartProjectSection />

      <!-- Newsletter signup -->
      <section class="relative py-16 max-w-2xl mx-auto text-center">
        <p class="font-hand text-2xl text-slate-700 mb-2">Stay in the loop</p>
        <p class="text-sm text-slate-500 mb-4">Practical pricing & lead-gen notes for Malaysian SMEs. No spam, unsubscribe anytime.</p>
        <div class="relative max-w-sm mx-auto">
          <NewsletterForm source="footer" client:load />
        </div>
        <p class="mt-6 text-xs text-slate-400 font-mono">We'll only send updates you asked for. See our <a href="/privacy-policy/" class="underline underline-offset-2 hover:text-slate-600">privacy policy</a>.</p>
        <p class="mt-4 text-sm text-slate-500">Want it all in one PDF? Get the free <a href="/guide/" class="font-medium text-blue-700 underline underline-offset-2 hover:text-blue-900">2026 Lead Generation Guide →</a></p>
      </section>

      <FooterSection client:load />
    </main>

    <StickyBooking client:load />
  </div>
</BaseLayout>
