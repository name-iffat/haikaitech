---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import WorkbenchNav from '../components/WorkbenchNav.astro';
import WorkbenchIcon from '../components/WorkbenchIcon.astro';
import FooterWorkbench from '../../components/FooterWorkbench';
import StickyBooking from '../../components/StickyBooking';
import draftingBoardArt from '../assets/concept-decorations/refined/hero-drafting-board.webp';
import coffeeCupArt from '../assets/concept-decorations/refined/hero-coffee-cup.webp';
import rulerArt from '../assets/concept-decorations/refined/hero-engineering-ruler.webp';
import '../styles/workbench.css';
import '../styles/services-pricing.css';

const whatsapp = 'https://wa.me/60147533499?text=Hi%20HaikaiTech!%20I%27d%20like%20a%20quotation%20for%20a%20website%20or%20system.';
const canonical = 'https://haikaitech.my/services/';
const alternates = { en: canonical, bm: 'https://haikaitech.my/bm/services/' };

const quickFacts = [
  { label: 'Starting point', value: 'Scope before price' },
  { label: 'Final price', value: 'Confirmed in quotation' },
  { label: 'Payment', value: '50% start / 50% handover' },
  { label: 'Ownership', value: 'Agreed deliverables handed over' },
];

const marketRanges = [
  { type: 'Brochure / business profile', range: 'RM1,500–RM5,000', scope: '3–5 pages, company information, services, contact and WhatsApp' },
  { type: 'Lead-generation website', range: 'RM4,000–RM10,000', scope: 'More pages, stronger calls to action, forms and conversion planning' },
  { type: 'Corporate / multi-service website', range: 'RM8,000–RM20,000', scope: '10–20 pages, multiple services, projects, teams and content structure' },
  { type: 'Ecommerce website', range: 'RM8,000–RM25,000', scope: 'Product catalogue, cart, checkout, payment, delivery and stock workflows' },
  { type: 'Custom platform', range: 'RM15,000–RM50,000+', scope: 'Booking, membership, dashboards, integrations and operational systems' },
];

const pricingModels = [
  { model: 'Promotional one-off build', method: 'A defined standard scope starts at a promotional price; the quotation confirms the final scope.', fit: 'A focused business presence', position: 'Available for selected scopes only' },
  { model: 'Scope-based fixed quotation', method: 'Requirements are reviewed before a fixed price and deliverables are issued.', fit: 'CMS, larger websites, ecommerce and integrations', position: 'Main model for most HaikaiTech projects' },
  { model: 'Phased custom build', method: 'A larger system is divided into useful, approved stages.', fit: 'Dashboards, booking systems and workflow tools', position: 'Available where phasing is technically suitable' },
  { model: 'Monthly subscription', method: 'Build, hosting and support are bundled into a recurring payment.', fit: 'Owners who prefer a recurring model', position: 'Not currently offered by HaikaiTech' },
];

const offerRoutes = [
  { icon: 'globe', label: 'Selected promotional scope', title: 'Website promotion', price: 'From RM1,500', description: 'For a focused business website within a defined promotional scope. Final pages, content, revisions, timeline and add-ons are confirmed in the quotation.', href: whatsapp, action: 'Discuss the promotional scope', external: true },
  { icon: 'layout', label: 'Content-led build', title: 'Business website and CMS', price: 'Quotation', description: 'For larger websites, multiple services, CMS, catalogue management, content updates or lead-generation requirements.', href: whatsapp, action: 'Discuss the website scope', external: true },
  { icon: 'blocks', label: 'Commerce route', title: 'Ecommerce, booking and payment', price: 'Quotation', description: 'Pricing depends on products, variations, stock rules, delivery, payment gateway, personalisation, pre-orders, integrations and third-party tools.', href: '/services/ecommerce/', action: 'Explore ecommerce builds', external: false },
  { icon: 'workflow', label: 'Operations route', title: 'Custom systems and automation', price: 'Quotation', description: 'For dashboards, portals, booking systems, internal workflows, integrations, AI agents, automation and custom web applications.', href: '/services/automation/', action: 'Explore automation builds', external: false },
] as const;

const priceFactors = [
  { icon: 'list-check', title: 'Number of pages', body: 'More pages mean more content structure, design decisions, review and testing.' },
  { icon: 'layout', title: 'Custom design complexity', body: 'A focused layout costs less than a fully bespoke visual system with many page types.' },
  { icon: 'book', title: 'Content readiness', body: 'Approved copy and images keep the build moving. Writing, editing or sourcing content adds scope.' },
  { icon: 'database', title: 'CMS and catalogue needs', body: 'Editable content, product records and permissions require additional setup and testing.' },
  { icon: 'blocks', title: 'Payments and integrations', body: 'Booking, ecommerce, payment gateways and connected tools introduce more workflows to verify.' },
  { icon: 'wrench', title: 'Ongoing services', body: 'Hosting, updates and third-party services are identified separately so ownership costs stay visible.' },
] as const;

const extraCosts = ['Copywriting', 'Photography and video', 'Product or content entry', 'Domain and hosting renewals', 'Paid plugins or licensed tools', 'Payment gateway transaction fees', 'Advertising budget', 'Complex integrations', 'Major revisions after approval', 'New pages outside the agreed scope', 'Data, storage or provider costs for custom systems'];

const process = [
  { title: 'Discuss the business', body: 'Share what needs to work better, who will use it and what already exists.' },
  { title: 'Choose a suitable route', body: 'We identify whether the work fits the promotion, a fixed quotation or a phased build.' },
  { title: 'Receive a formal quotation', body: 'The quotation confirms deliverables, exclusions, timeline, revisions and external costs.' },
  { title: 'Pay 50% to begin', body: 'The approved deposit reserves the work and starts the agreed project.' },
  { title: 'Build, review and test', body: 'Work is reviewed on staging before the final launch or handover.' },
  { title: 'Pay the final 50%', body: 'The balance is due before final launch and handover unless the quotation states otherwise.' },
  { title: 'Receive the handover', body: 'Agreed credentials, source and deliverables are handed over after completion.' },
];

const faqs = [
  { q: 'How much does a website cost?', a: 'The final price depends on pages, content, revisions, timeline, integrations and ongoing costs, and is confirmed in a formal quotation. A selected promotional route is shown below for focused business-website scopes.' },
  { q: 'What does the website promotion include?', a: 'It is a promotional starting route for selected focused business-website scopes. The quotation confirms the exact pages, content responsibilities, revisions, timeline, integrations and handover terms before work begins.' },
  { q: 'Why do ecommerce and booking websites require a quotation?', a: 'Their cost changes with products, variants, stock rules, delivery, payment gateways, booking logic, personalisation, integrations and third-party services. A quotation prevents a misleading package price.' },
  { q: 'What is the difference between a promotional price and a formal quotation?', a: 'A promotional price is a starting point for a defined type of project. A formal quotation is the project-specific commercial document that confirms the final scope, price, deliverables, exclusions and payment terms.' },
  { q: 'What costs may exist after launch?', a: 'Depending on the project, ongoing costs may include domain and hosting renewals, paid plugins, provider usage, storage, payment gateway fees, content updates and future development. These are identified in the quotation where known.' },
  { q: 'How does payment work?', a: 'For standard projects, 50% is paid to start and 50% before final launch or handover. Larger systems may be divided into approved phases with a payment split stated in the quotation.' },
  { q: 'Do I own the website after completion?', a: 'For completed one-time quoted projects, the agreed credentials, source and deliverables are handed over after final payment, subject to the quotation and any third-party licence terms.' },
];

const serviceSchema = {
  '@context': 'https://schema.org', '@type': 'Service', name: 'Website design and custom software development',
  description: 'Promotional business website scopes from RM1,500, plus quotation-based CMS, ecommerce, booking, automation and custom systems for Malaysian businesses.',
  provider: { '@type': 'Organization', name: 'HaikaiTech Solutions', url: 'https://haikaitech.my/' },
  areaServed: { '@type': 'Country', name: 'Malaysia' },
  offers: { '@type': 'Offer', name: 'Selected standard website promotion', price: '1500', priceCurrency: 'MYR', description: 'Promotional starting price for selected standard website scopes. Final scope and price are confirmed in a formal quotation.', url: 'https://haikaitech.my/services/#pricing' },
};

const faqSchema = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((faq) => ({ '@type': 'Question', name: faq.q, acceptedAnswer: { '@type': 'Answer', text: faq.a } })) };
---

<BaseLayout title="Website Pricing Malaysia | Services & Quotations | HaikaiTech" description="HaikaiTech website promotions start from RM1,500 for selected scopes. Compare indicative Malaysian market ranges and learn how websites, ecommerce, automation and custom systems are quoted." canonical={canonical} alternates={alternates}>
  <div class="workbench wb-pricing-site bg-paper bg-grid-pattern">
    <WorkbenchNav />
    <main class="sp-main">
      <section class="sp-hero" aria-labelledby="services-title">
        <div class="sp-hero-copy">
          <p class="wb-eyebrow"><WorkbenchIcon name="briefcase" size={18} />Services &amp; pricing</p>
          <h1 id="services-title">Website pricing that starts with the <em>real scope.</em></h1>
          <p class="sp-hero-lede">Selected website promotions are available for focused scopes. Websites involving CMS, ecommerce, booking, payments or business systems are quoted according to the actual scope.</p>
          <div class="sp-actions"><a class="wb-button wb-button--painted" href={whatsapp} target="_blank" rel="noopener noreferrer"><span>Request a quotation</span></a><a class="wb-button wb-secondary" href="#market-ranges"><span>Understand the ranges</span></a></div>
          <p class="sp-hero-note">Clear scope first. Then the number means something.</p>
        </div>
        <div class="sp-hero-scene">
          <Image class="sp-drafting-board" src={draftingBoardArt} alt="" width={1200} format="webp" loading="eager" aria-hidden="true" />
          <Image class="sp-coffee-cup" src={coffeeCupArt} alt="" width={180} format="webp" loading="eager" aria-hidden="true" />
          <div class="sp-scope-board" aria-label="Items confirmed in a formal quotation">
            <span class="sp-board-pin" aria-hidden="true"></span>
            <div class="sp-board-head"><p>Quotation worksheet</p><span>Scope before price</span></div>
            <p class="sp-board-title">The final quotation confirms:</p>
            <ul><li><span>01</span>Pages and content</li><li><span>02</span>Review rounds</li><li><span>03</span>Timeline</li><li><span>04</span>Integrations</li><li><span>05</span>Ownership and handover</li><li><span>06</span>Recurring and third-party costs</li></ul>
            <p class="sp-board-caption">No internal quotation totals are used as public package prices.</p>
          </div>
          <Image class="sp-ruler" src={rulerArt} alt="" width={280} format="webp" loading="eager" aria-hidden="true" />
        </div>
      </section>

      <dl class="sp-quick-facts" aria-label="Pricing quick facts">{quickFacts.map((fact) => <div><dt>{fact.label}</dt><dd>{fact.value}</dd></div>)}</dl>

      <section id="market-ranges" class="sp-section sp-section--ranges" aria-labelledby="market-title">
        <header class="sp-section-head"><div><p class="wb-eyebrow">Market context</p><h2 id="market-title">Typical Malaysian market ranges</h2></div><p>These ranges help you compare project types before asking for a quotation. They are context, not HaikaiTech package prices.</p></header>
        <div class="sp-table-wrap" tabindex="0" role="region" aria-label="Typical Malaysian website market ranges"><table><thead><tr><th scope="col">Website type</th><th scope="col">Typical market range</th><th scope="col">Usually involves</th></tr></thead><tbody>{marketRanges.map((row) => <tr><th scope="row">{row.type}</th><td class="sp-price">{row.range}</td><td>{row.scope}</td></tr>)}</tbody></table></div>
        <p class="sp-source-note">These are indicative Malaysian market ranges for comparison only, based on <a href="https://zenweb.my/services/web-design/pricing/" target="_blank" rel="noopener noreferrer">public industry pricing references</a>. They are not HaikaiTech’s fixed prices or a guarantee of what a project will cost.</p>
      </section>

      <section class="sp-section sp-section--models" aria-labelledby="models-title">
        <header class="sp-section-head"><div><p class="wb-eyebrow">Commercial models</p><h2 id="models-title">How website projects are priced</h2></div><p>The billing model should match the certainty of the scope. HaikaiTech currently works through promotions, fixed quotations and suitable phased builds.</p></header>
        <div class="sp-table-wrap" tabindex="0" role="region" aria-label="Website pricing models"><table><thead><tr><th scope="col">Pricing model</th><th scope="col">How it works</th><th scope="col">Best for</th><th scope="col">HaikaiTech position</th></tr></thead><tbody>{pricingModels.map((row) => <tr><th scope="row">{row.model}</th><td>{row.method}</td><td>{row.fit}</td><td class="sp-position">{row.position}</td></tr>)}</tbody></table></div>
      </section>

      <section id="pricing" class="sp-section sp-section--offers" aria-labelledby="offers-title">
        <header class="sp-section-head"><div><p class="wb-eyebrow">Current routes</p><h2 id="offers-title">Choose the closest starting point</h2></div><p>You do not need to diagnose the whole project yourself. Pick the nearest route and the quotation will define the edges.</p></header>
        <div class="sp-offer-register">{offerRoutes.map((route) => <article class="sp-offer-row"><span class="sp-offer-icon" aria-hidden="true"><WorkbenchIcon name={route.icon} size={22} /></span><div class="sp-offer-title"><p>{route.label}</p><h3>{route.title}</h3></div><p class="sp-offer-description">{route.description}</p><div class="sp-offer-action"><strong>{route.price}</strong><a href={route.href} target={route.external ? '_blank' : undefined} rel={route.external ? 'noopener noreferrer' : undefined}>{route.action}</a></div></article>)}</div>
      </section>

      <section class="sp-section sp-section--factors" aria-labelledby="factors-title">
        <header class="sp-section-head"><div><p class="wb-eyebrow">Scope drivers</p><h2 id="factors-title">The six things that change the price</h2></div><p>A quote changes because the work changes. These are the practical decisions that have the largest effect.</p></header>
        <div class="sp-factor-grid">{priceFactors.map((factor) => <article><span aria-hidden="true"><WorkbenchIcon name={factor.icon} size={21} /></span><h3>{factor.title}</h3><p>{factor.body}</p></article>)}</div>
      </section>

      <section id="maintenance" class="sp-section sp-section--extras" aria-labelledby="extras-title">
        <header class="sp-section-head"><div><p class="wb-eyebrow">Scope boundaries</p><h2 id="extras-title">What may cost extra</h2></div><p>The quotation separates work and running costs that are not part of the agreed build. Nothing below receives a universal price before its scope is known.</p></header>
        <ul class="sp-extra-list">{extraCosts.map((item) => <li><span aria-hidden="true">—</span>{item}</li>)}</ul>
      </section>

      <section id="custom-software" class="sp-section sp-section--process" aria-labelledby="process-title">
        <header class="sp-section-head"><div><p class="wb-eyebrow">Quotation process</p><h2 id="process-title">From useful brief to handover</h2></div><p>Standard projects use a 50/50 payment flow. Larger systems may be divided into approved phases, each with terms stated in the quotation.</p></header>
        <ol class="sp-process-list">{process.map((step, index) => <li><span>{String(index + 1).padStart(2, '0')}</span><div><h3>{step.title}</h3><p>{step.body}</p></div></li>)}</ol>
      </section>

      <section id="faq" class="sp-section sp-section--faq" aria-labelledby="faq-title">
        <header class="sp-section-head"><div><p class="wb-eyebrow">Common questions</p><h2 id="faq-title">Pricing, without the fog</h2></div><p>Short answers to the questions that should be settled before a project begins.</p></header>
        <div class="sp-faq-list">{faqs.map((faq) => <details><summary>{faq.q}<span aria-hidden="true">+</span></summary><p>{faq.a}</p></details>)}</div>
      </section>

      <section class="sp-cta" aria-labelledby="services-cta-title"><div><p class="wb-eyebrow">Next useful step</p><h2 id="services-cta-title">Bring the scope.<br /><em>We’ll price the real job.</em></h2></div><div><p>Tell us what the website or system needs to do. We’ll identify the right route and prepare a formal quotation.</p><div class="sp-actions"><a class="wb-button wb-button--painted" href={whatsapp} target="_blank" rel="noopener noreferrer"><span>Request a quotation</span></a><a class="sp-email-link" href="mailto:hq@haikaitech.my?subject=Project%20quotation">Email hq@haikaitech.my</a></div></div></section>
    </main>
    <FooterWorkbench client:load />
    <StickyBooking client:load />
  </div>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(serviceSchema)}></script>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)}></script>
</BaseLayout>
