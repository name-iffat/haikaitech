---
import type { CollectionEntry } from 'astro:content';
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../../components/Navbar';
import StickyBooking from '../../../components/StickyBooking';
import NewsletterForm from '../../../components/NewsletterForm';
import { ArrowLeft, MessageCircle, Tag } from 'lucide-react';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props as { post: CollectionEntry<'blog'> };
const { Content } = await render(post);

const allPosts = (await getCollection('blog')).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const related = allPosts.filter((p) => p.id !== post.id).slice(0, 3);

const readingTime = Math.max(1, Math.round(post.body.trim().split(/\s+/).length / 200));
const wordCount = post.body.trim().split(/\s+/).length;
const formatDate = (date: Date) =>
  new Date(date).toLocaleDateString('en-GB', { year: 'numeric', month: 'long', day: 'numeric' });
const pubDate = new Date(post.data.pubDate).toISOString();
const canonical = `https://haikaitech.my/blog/${post.id}/`;

const blogSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  datePublished: pubDate,
  inLanguage: 'en',
  wordCount: wordCount,
  url: canonical,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  author: {
    '@type': 'Organization',
    name: 'HaikaiTech Solutions',
    url: 'https://haikaitech.my/',
    identifier: '202603149868',
  },
  publisher: {
    '@type': 'Organization',
    name: 'HaikaiTech Solutions',
    url: 'https://haikaitech.my/',
    identifier: '202603149868',
  },
};
---

<BaseLayout title={`${post.data.title} | HaikaiTech Blog`} description={post.data.description} canonical={canonical}>
  <div class="min-h-screen relative font-sans bg-paper bg-grid-pattern selection:bg-yellow-200 selection:text-slate-900">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(blogSchema, null, 2)}></script>
    <Navbar client:load prefix="/" />

    <main class="max-w-3xl mx-auto px-6 py-20 md:py-28 relative">
      <!-- Back link -->
      <a href="/blog/" class="inline-flex items-center gap-2 text-slate-500 hover:text-slate-800 font-mono text-sm mb-10 transition-colors">
        <ArrowLeft class="w-4 h-4" />
        ../back_to_blog
      </a>

      <!-- Header -->
      <header class="mb-10">
        <div class="flex flex-wrap items-center gap-3 mb-4">
          <span class="font-mono text-xs text-slate-500 uppercase tracking-wider">Field Note</span>
          <span class="font-mono text-xs text-slate-500">·</span>
          <time datetime={pubDate} class="font-mono text-xs text-slate-500">{formatDate(post.data.pubDate)}</time>
          <span class="font-mono text-xs text-slate-500">·</span>
          <span class="font-mono text-xs text-slate-500">{readingTime} min read</span>
        </div>
        <h1 class="text-3xl md:text-5xl font-bold text-slate-900 tracking-tight leading-tight">{post.data.title}</h1>
        <p class="mt-5 text-xl text-slate-600 font-light leading-relaxed">{post.data.description}</p>
        <div class="flex flex-wrap gap-2 mt-6">
          {post.data.tags.map((tag) => (
            <span class="px-3 py-1 text-sm font-mono bg-slate-100 border border-slate-200 text-slate-600 rounded-full flex items-center gap-1">
              <Tag class="w-3 h-3 opacity-40" />
              {tag}
            </span>
          ))}
        </div>
      </header>

      <div class="border-t border-slate-200 pt-10">
        <article class="article-content">
          <Content />
        </article>
      </div>

      <!-- Author line -->
      <div class="mt-12 bg-white border border-slate-200 rounded-2xl p-6 flex items-center gap-4">
        <div class="w-12 h-12 rounded-full bg-blue-700 text-white flex items-center justify-center font-hand text-xl">IH</div>
        <div>
          <p class="font-bold text-slate-800">HaikaiTech Solutions</p>
          <p class="text-sm text-slate-500">
            Registered software engineering studio in Penang, serving businesses across Malaysia — most clients in Kuala Lumpur. Built on React, .NET, and Unity.
          </p>
        </div>
      </div>

      <!-- CTA -->
      <div class="mt-12 bg-slate-900 text-slate-100 p-8 md:p-10 rounded-2xl text-center relative overflow-hidden">
        <div class="absolute top-0 right-0 w-64 h-64 bg-blue-600/20 rounded-full blur-3xl -translate-y-1/2 translate-x-1/2 pointer-events-none"></div>
        <div class="relative z-10">
          <h2 class="font-hand text-3xl text-slate-100">Have a project like this in mind?</h2>
          <p class="mt-3 text-slate-400">Chat on WhatsApp — we&apos;ll scope it and send a fixed quotation.</p>
          <div class="mt-6 flex flex-wrap justify-center gap-4">
            <a
              href="https://wa.me/60147533499?text=Hi%20HaikaiTech!%20I%20read%20your%20blog%20and%20have%20a%20project%20in%20mind."
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 bg-[#25D366] text-white rounded-xl px-6 py-3 font-mono text-sm hover:bg-[#20b858] active:scale-[0.98] transition-all"
            >
              <MessageCircle class="w-4 h-4" />
              Chat on WhatsApp
            </a>
            <a
              href="/services/"
              class="inline-flex items-center gap-2 border border-slate-600 text-slate-300 rounded-xl px-6 py-3 font-mono text-sm hover:border-slate-400 hover:text-white transition-colors"
            >
              See services &amp; pricing
            </a>
          </div>
        </div>
      </div>

      <!-- Related -->
      {related.length > 0 && (
        <div class="mt-14">
          <h2 class="text-xl font-bold text-slate-800 mb-6">Keep reading</h2>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            {related.map((p) => (
              <a
                href={`/blog/${p.id}/`}
                class="group block p-5 bg-white border border-slate-200 rounded-xl hover:shadow-lg hover:-translate-y-1 transition-all"
              >
                <p class="font-mono text-xs text-slate-500 mb-2">{formatDate(p.data.pubDate)}</p>
                <h3 class="font-bold text-slate-800 group-hover:text-blue-700 transition-colors leading-snug">{p.data.title}</h3>
              </a>
            ))}
          </div>
        </div>
      )}

      <!-- Newsletter subscribe -->
      <div class="mt-14 bg-slate-50 border border-slate-200 rounded-2xl p-8 text-center">
        <p class="font-hand text-2xl text-slate-700 mb-2">Stay in the loop</p>
        <p class="text-sm text-slate-500 mb-4">Practical pricing & lead-gen notes for Malaysian SMEs — no spam, unsubscribe anytime.</p>
        <div class="max-w-sm mx-auto relative">
          <NewsletterForm source="blog" client:load />
        </div>
        <p class="mt-6 text-xs text-slate-400 font-mono">We'll only send updates you asked for. See our <a href="/privacy-policy/" class="underline underline-offset-2 hover:text-slate-600">privacy policy</a>.</p>
      </div>

      <footer class="border-t border-slate-200 mt-16 py-10 text-center text-slate-400 text-sm font-mono">
        <div class="flex items-center justify-center gap-2">
          <div class="w-3 h-3 bg-green-400 rounded-full animate-pulse"></div>
          &copy; {new Date().getFullYear()} HaikaiTech
        </div>
      </footer>
    </main>

    <StickyBooking client:load />
  </div>
</BaseLayout>



