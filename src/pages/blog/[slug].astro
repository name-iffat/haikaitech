---
import type { CollectionEntry } from 'astro:content';
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import WorkbenchNav from '../../components/WorkbenchNav.astro';
import StickyBooking from '../../../components/StickyBooking';
import FooterWorkbench from '../../../components/FooterWorkbench';
import '../../styles/workbench.css';
import '../../styles/article.css';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props as { post: CollectionEntry<'blog'> };
const { Content, headings } = await render(post);

const allPosts = (await getCollection('blog')).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const related = allPosts.filter((p) => p.id !== post.id).slice(0, 3);

const readingTime = Math.max(1, Math.round(post.body.trim().split(/\s+/).length / 200));
const wordCount = post.body.trim().split(/\s+/).length;
const formatDate = (date: Date) =>
  new Date(date).toLocaleDateString('en-GB', { year: 'numeric', month: 'long', day: 'numeric' });
const pubDate = new Date(post.data.pubDate).toISOString();
const canonical = `https://haikaitech.my/blog/${post.id}/`;

const blogSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  datePublished: pubDate,
  inLanguage: 'en',
  wordCount: wordCount,
  url: canonical,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  author: {
    '@type': 'Organization',
    name: 'HaikaiTech Solutions',
    url: 'https://haikaitech.my/',
    identifier: '202603149868',
  },
  publisher: {
    '@type': 'Organization',
    name: 'HaikaiTech Solutions',
    url: 'https://haikaitech.my/',
    identifier: '202603149868',
  },
};
---

<BaseLayout title={`${post.data.title} | HaikaiTech Blog`} description={post.data.description} canonical={canonical}>
  <div class="workbench wb-article-page">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(blogSchema, null, 2)}></script>
    <WorkbenchNav />

    <main class="wa-main">
      <a class="wa-back" href="/blog/">
        <span aria-hidden="true">/</span>
        Insights / all field notes
      </a>

      <header class="wa-hero" aria-labelledby="article-title">
        <div class="wa-hero-copy">
          <p class="wb-eyebrow">Insights / Field note</p>
          <h1 id="article-title">{post.data.title}</h1>
          <p class="wa-lede">{post.data.description}</p>
          <div class="wa-meta" aria-label="Article metadata">
            <time datetime={pubDate}>{formatDate(post.data.pubDate)}</time>
            <span aria-hidden="true">·</span>
            <span>{readingTime} min read</span>
            <span aria-hidden="true">·</span>
            <span>{wordCount} words</span>
          </div>
          <div class="wa-topics" aria-label="Article topics">
            {post.data.tags.map((tag) => <span>{tag}</span>)}
          </div>
        </div>

        <aside class="wa-docket" aria-label="Field note details">
          <p class="wa-docket-label">WORKSHOP FILE</p>
          <dl>
            <div><dt>Filed</dt><dd>{formatDate(post.data.pubDate)}</dd></div>
            <div><dt>Read</dt><dd>{readingTime} min</dd></div>
            <div><dt>Topics</dt><dd>{post.data.tags.length}</dd></div>
          </dl>
          <p class="wa-docket-note" aria-hidden="true">notes worth keeping.</p>
        </aside>
      </header>

      {headings.filter((heading) => heading.depth === 2).length > 0 && (
        <nav class="wa-toc" aria-label="In this article">
          <div class="wa-toc-head">
            <p>In this article</p>
            <span>{headings.filter((heading) => heading.depth === 2).length} sections</span>
          </div>
          <ol>
            {headings.filter((heading) => heading.depth === 2).map((heading, index) => (
              <li>
                <a href={`#${heading.slug}`}>
                  <span>{String(index + 1).padStart(2, '0')}</span>
                  <b>{heading.text}</b>
                </a>
              </li>
            ))}
          </ol>
        </nav>
      )}

      <div class="wa-rule" aria-hidden="true"></div>

      <div class="wa-reading-layout">
        <article class="wa-paper article-content">
          <header class="wa-paper-head">
            <span>FIELD NOTE / {post.id.replaceAll('-', ' ')}</span>
            <span>{wordCount} words</span>
          </header>
          <div class="wa-paper-body">
            <Content />
          </div>
          <footer class="wa-author">
            <div class="wa-author-mark" aria-hidden="true">HT</div>
            <div>
              <p>Filed by HaikaiTech Solutions</p>
              <span>Penang, Malaysia · serving businesses across Malaysia.</span>
            </div>
          </footer>
        </article>
      </div>

      <section class="wa-project" aria-labelledby="project-question">
        <div>
          <p class="wb-eyebrow">Have a project in mind?</p>
          <h2 id="project-question">Let&apos;s make the useful version.</h2>
        </div>
        <div class="wa-project-actions">
          <p>Chat on WhatsApp and we&apos;ll scope it into a fixed quotation.</p>
          <div>
            <a
              class="wb-button wb-primary wb-button--painted"
              href="https://wa.me/60147533499?text=Hi%20HaikaiTech!%20I%20read%20your%20blog%20and%20have%20a%20project%20in%20mind."
              target="_blank"
              rel="noopener noreferrer"
            >Chat on WhatsApp</a>
            <a class="wb-button wb-secondary" href="/services/">See services &amp; pricing</a>
          </div>
        </div>
      </section>

      {related.length > 0 && (
        <section class="wa-related" aria-labelledby="related-title">
          <header>
            <p class="wb-eyebrow">More field notes</p>
            <h2 id="related-title">Keep reading.</h2>
          </header>
          <div class="wa-related-list">
            {related.map((p) => (
              <a href={`/blog/${p.id}/`}>
                <time datetime={p.data.pubDate.toISOString()}>{formatDate(p.data.pubDate)}</time>
                <strong>{p.data.title}</strong>
                <span>Read note</span>
              </a>
            ))}
          </div>
        </section>
      )}
    </main>

    <FooterWorkbench client:load newsletterSource="blog" />
    <StickyBooking client:load />
  </div>
</BaseLayout>
