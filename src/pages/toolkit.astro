---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import WorkbenchNav from '../components/WorkbenchNav.astro';
import WorkbenchIcon from '../components/WorkbenchIcon.astro';
import FooterWorkbench from '../../components/FooterWorkbench';
import heroArt from '../assets/concept-decorations/refined/toolkit-hero.png';
import invoiceArt from '../assets/concept-decorations/refined/toolkit-invoice.png';
import quotationArt from '../assets/concept-decorations/refined/toolkit-quotation.png';
import receiptArt from '../assets/concept-decorations/refined/toolkit-receipt.png';
import '../styles/workbench.css';
import '../styles/toolkit.css';

const tools = [
  {
    slug: 'invoice', name: 'Invoice Generator', image: invoiceArt,
    url: 'https://invoice.haikaitech.my', action: 'Open invoice generator',
    description: 'Create an invoice and download a PDF.',
    detail: 'Add your business details, line items and taxes. Automatic numbering keeps documents organised.',
  },
  {
    slug: 'quotation', name: 'Quotation Builder', image: quotationArt,
    url: 'https://invoice.haikaitech.my/?type=quotation', action: 'Open quotation builder',
    description: 'Prepare an itemised quote for your client.',
    detail: 'Set a validity period and convert accepted quotations into invoices.',
  },
  {
    slug: 'receipt', name: 'Receipt Maker', image: receiptArt,
    url: 'https://invoice.haikaitech.my/?type=receipt', action: 'Open receipt maker',
    description: 'Create a receipt for a payment received.',
    detail: 'Generate numbered receipts that link back to your invoices.',
  },
];

const upcoming = [
  { name: 'Purchase Order', icon: 'briefcase', description: 'Vendor details and order tracking.' },
  { name: 'Payroll Calculator', icon: 'list-check', description: 'Malaysian payroll contributions and payslips.' },
] as const;

const toolkitSchema = {
  '@context': 'https://schema.org', '@type': 'ItemList',
  name: 'HaikaiTech Business Toolkit', description: 'Free document tools for Malaysian businesses.',
  itemListElement: tools.map((tool, index) => ({
    '@type': 'ListItem', position: index + 1, name: tool.name, url: tool.url,
  })),
};
const applicationSchema = {
  '@context': 'https://schema.org', '@type': 'SoftwareApplication',
  name: 'HaikaiTech Invoice Generator', url: tools[0].url,
  applicationCategory: 'BusinessApplication', operatingSystem: 'Any',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'MYR' },
  description: 'Free invoice generator for Malaysian businesses with PDF download.',
};
---

<BaseLayout
  title="HaikaiTech Business Toolkit | Free Tools for Malaysian SMEs"
  description="Free document tools for Malaysian businesses. Create invoices, itemised quotations and receipts. Purchase orders and payroll tools are in development."
  canonical="https://haikaitech.my/toolkit/"
>
  <div class="workbench wb-toolkit-page">
    <WorkbenchNav />
    <main id="toolkit" class="tk-main">
      <header class="tk-hero" aria-labelledby="toolkit-title">
        <div class="tk-hero-copy">
          <p class="wb-eyebrow">Solutions / Business Toolkit</p>
          <h1 id="toolkit-title">Less paperwork.<br /><span>More doing.<svg class="tk-headline-marks" viewBox="0 0 48 64" aria-hidden="true"><path d="m10 21 20-13M13 32h27M10 43l20 13" /></svg></span></h1>
          <p class="tk-intro">Free document tools for Malaysian businesses.</p>
          <div class="tk-actions">
            <a class="wb-button wb-primary wb-button--painted" href={tools[0].url}><span>Open invoice generator</span></a>
            <a class="wb-button wb-secondary" href="#tools">Browse tools</a>
          </div>
        </div>
        <figure class="tk-hero-scene" aria-hidden="true">
          <Image src={heroArt} alt="" width={1200} widths={[480, 800, 1200]} sizes="(max-width: 767px) 100vw, 54vw" format="webp" loading="eager" fetchpriority="high" />
          <figcaption>paperwork,<br />sorted.</figcaption>
        </figure>
        <p class="tk-hero-footnote">Simple tools. Real work.<span aria-hidden="true"></span></p>
      </header>

      <section id="tools" class="tk-tools" aria-labelledby="tools-title">
        <header>
          <p class="wb-eyebrow">Ready to use</p>
          <h2 id="tools-title">Pick a tool. Get it done.</h2>
        </header>
        <div class="tk-tool-list">
          {tools.map(tool => (
            <article class="tk-tool" aria-labelledby={`${tool.slug}-title`}>
              <div class="tk-tool-art" aria-hidden="true">
                <Image src={tool.image} alt="" width={720} widths={[360, 540, 720]} sizes="(max-width: 599px) 90vw, (max-width: 1023px) 38vw, 30vw" format="webp" loading="lazy" />
              </div>
              <div class="tk-tool-copy">
                <h3 id={`${tool.slug}-title`}>{tool.name}</h3>
                <p>{tool.description}</p>
                <a class="tk-tool-link" href={tool.url}>{tool.action}</a>
                <details class="tk-tool-details">
                  <summary>What you can do</summary>
                  <p>{tool.detail}</p>
                </details>
              </div>
            </article>
          ))}
        </div>
      </section>

      <section class="tk-upcoming" aria-labelledby="upcoming-title">
        <h2 id="upcoming-title" class="wb-eyebrow">On the workbench</h2>
        <div class="tk-upcoming-list">
          {upcoming.map(tool => (
            <article>
              <span class="tk-upcoming-icon"><WorkbenchIcon name={tool.icon} size={24} /></span>
              <div><h3>{tool.name}</h3><p class="tk-upcoming-status">In development</p><p class="tk-upcoming-description">{tool.description}</p></div>
            </article>
          ))}
          <p class="tk-upcoming-note">More tools<br />on the workbench.</p>
        </div>
      </section>

      <section class="tk-custom" aria-labelledby="custom-title">
        <div><p class="wb-eyebrow">Built around your business</p><h2 id="custom-title">Need a tool<br />of your own?</h2></div>
        <div class="tk-custom-copy">
          <p>We build custom web apps, dashboards and automation for Malaysian businesses. Tell us what needs to work better.</p>
          <div class="tk-actions">
            <a class="wb-button wb-primary wb-button--painted" href="https://wa.me/60147533499?text=Hi%20HaikaiTech!%20I%20just%20used%20your%20free%20toolkit%20and%20would%20love%20to%20discuss%20a%20project." target="_blank" rel="noopener noreferrer"><span>Discuss your project</span></a>
            <a class="tk-tool-link" href="/#projects">See our work</a>
          </div>
        </div>
      </section>
    </main>
    <FooterWorkbench newsletterSource="toolkit" client:load />
  </div>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(toolkitSchema)}></script>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(applicationSchema)}></script>
</BaseLayout>
