---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar';
import FooterSection from '../../components/FooterSection';
import { DoodleStar, ScribbleUnderline, ArrowSketch, Tape } from '../../components/Decorations';

const tools = [
  {
    slug: 'invoice',
    name: 'Invoice Generator',
    tagline: 'Professional invoices in seconds',
    status: 'live',
    url: 'https://invoice.haikaitech.my',
    description: 'Create clean, SSM-ready invoices with auto-numbering, tax line items, and PDF download. No sign-up needed.',
    icon: 'invoice',
  },
  {
    slug: 'quotation',
    name: 'Quotation Builder',
    tagline: 'Win jobs with polished quotes',
    status: 'soon',
    url: null,
    description: 'Build itemised quotations with validity periods, then convert accepted quotes straight into invoices.',
    icon: 'quotation',
  },
  {
    slug: 'receipt',
    name: 'Receipt Maker',
    tagline: 'Official receipts on demand',
    status: 'soon',
    url: null,
    description: 'Generate numbered official receipts that link back to invoices for clean, audit-ready bookkeeping.',
    icon: 'receipt',
  },
  {
    slug: 'purchase-order',
    name: 'Purchase Order',
    tagline: 'Order stock without the spreadsheet',
    status: 'soon',
    url: null,
    description: 'Create and track purchase orders with vendor details and simple open / received status flow.',
    icon: 'po',
  },
  {
    slug: 'payroll',
    name: 'Payroll Calculator',
    tagline: 'Salary, EPF, SOCSO & EIS made simple',
    status: 'soon',
    url: null,
    description: 'Calculate Malaysian payroll contributions and generate clean payslips in a few clicks.',
    icon: 'payroll',
  },
];

const valueProps = [
  { title: 'Free forever', body: 'Every tool is free to use. No trials, no paywalls, no credit card required.' },
  { title: 'No login required', body: 'Open a tool and start working. Your documents are generated right in your browser.' },
  { title: 'Malaysian business ready', body: 'Built around SME workflows — SSM-ready fields, tax line items, and proper legal documents.' },
  { title: 'Clean PDFs, no watermark', body: 'Output looks like it came from a proper office suite — because it should.' },
];
---

<BaseLayout
  title="HaikaiTech Business Toolkit | Free Tools for Malaysian SMEs"
  description="Free business tools for Malaysian SMEs — invoice generator, quotation builder, receipt maker, purchase orders, and payroll calculator. No login, clean PDFs, no watermark."
  canonical="https://haikaitech.my/toolkit/"
>
  <div class="min-h-screen relative font-sans bg-paper bg-grid-pattern selection:bg-yellow-200 selection:text-slate-900">
    <Navbar client:load prefix="/" />

    <main class="max-w-5xl mx-auto px-6 py-20 md:py-28 relative">
      <DoodleStar className="top-24 left-8 text-slate-300 animate-pulse hidden lg:block" />
      <DoodleStar className="top-48 right-16 text-blue-200 hidden lg:block" />
      <DoodleStar className="bottom-96 left-1/4 text-orange-200 hidden lg:block" />

      <!-- Hero -->
      <header class="relative mb-24 md:mb-32">
        <Tape className="-top-4 right-8 rotate-[-6deg] hidden md:block" />
        <p class="font-mono text-sm text-blue-700 tracking-widest uppercase">HaikaiTech Business Toolkit</p>
        <h1 class="mt-4 font-hand text-5xl md:text-7xl text-slate-800 leading-tight relative">
          Free tools for
          <br />
          <span class="text-blue-700 relative">
            Malaysian SMEs
            <ScribbleUnderline className="w-full text-blue-400" />
          </span>
        </h1>
        <p class="mt-8 max-w-xl text-slate-600 text-lg font-light">
          A growing collection of practical business tools — invoices, quotations, receipts, purchase orders and payroll.
          Built for how Malaysian small businesses actually work.
        </p>
        <div class="mt-10 flex flex-wrap items-center gap-4">
          <a
            href="https://invoice.haikaitech.my"
            class="bg-blue-700 text-white rounded-xl px-6 py-3 font-mono text-sm hover:bg-blue-800 active:scale-[0.98] transition-all shadow-[0_4px_14px_rgba(29,78,216,0.35)]"
          >
            Open Invoice Generator →
          </a>
          <a
            href="#tools"
            class="border border-slate-300 bg-white text-slate-700 rounded-xl px-6 py-3 font-mono text-sm hover:border-slate-400 hover:text-slate-900 transition-colors"
          >
            Browse all tools
          </a>
        </div>
        <ArrowSketch className="bottom-0 right-8 hidden lg:block text-blue-500 rotate-[10deg]" />
      </header>

      <!-- Tools Grid -->
      <section id="tools" class="mb-24 md:mb-32 scroll-mt-28 relative">
        <p class="font-mono text-xs text-slate-400 uppercase tracking-widest">01 / The Toolkit</p>
        <h2 class="mt-3 font-hand text-4xl md:text-5xl text-slate-800">Pick a tool, get to work</h2>

        <div class="mt-10 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {tools.map((tool) => (
            <div
              class={`relative bg-white border rounded-2xl p-6 flex flex-col transition-all ${
                tool.status === 'live'
                  ? 'border-blue-200 shadow-[0_8px_30px_rgba(29,78,216,0.08)] hover:shadow-[0_12px_40px_rgba(29,78,216,0.14)] hover:-translate-y-1'
                  : 'border-slate-200 shadow-[0_8px_30px_rgb(0,0,0,0.04)] hover:-translate-y-1 hover:shadow-[0_12px_40px_rgb(0,0,0,0.08)]'
              } transition-all`}
            >
              <div class="flex items-start justify-between">
                <span
                  class={`p-2.5 rounded-xl ${
                    tool.status === 'live'
                      ? 'bg-blue-50 text-blue-700'
                      : 'bg-slate-100 text-slate-400'
                  }`}
                >
                  {tool.icon === 'invoice' && (
                    <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                      <polyline points="14 2 14 8 20 8" />
                      <line x1="16" y1="13" x2="8" y2="13" />
                      <line x1="16" y1="17" x2="8" y2="17" />
                    </svg>
                  )}
                  {tool.icon === 'quotation' && (
                    <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <line x1="19" y1="5" x2="5" y2="19" />
                      <circle cx="6.5" cy="6.5" r="2.5" />
                      <circle cx="17.5" cy="17.5" r="2.5" />
                    </svg>
                  )}
                  {tool.icon === 'receipt' && (
                    <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M4 2v20l2-1 2 1 2-1 2 1 2-1 2 1 2-1 2 1V2l-2 1-2-1-2 1-2-1-2 1-2-1-2 1Z" />
                      <path d="M16 8h-6a2 2 0 1 0 0 4h4a2 2 0 1 1 0 4H8" />
                      <path d="M12 17.5v-11" />
                    </svg>
                  )}
                  {tool.icon === 'po' && (
                    <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <circle cx="8" cy="21" r="1" />
                      <circle cx="19" cy="21" r="1" />
                      <path d="M2.05 2.05h2l2.66 12.42a2 2 0 0 0 2 1.58h9.78a2 2 0 0 0 1.95-1.57l1.65-7.43H5.12" />
                    </svg>
                  )}
                  {tool.icon === 'payroll' && (
                    <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <rect width="16" height="20" x="4" y="2" rx="2" />
                      <line x1="8" y1="6" x2="16" y2="6" />
                      <line x1="16" y1="14" x2="16" y2="18" />
                      <path d="M16 10h.01" />
                      <path d="M12 10h.01" />
                      <path d="M8 10h.01" />
                      <path d="M12 14h.01" />
                      <path d="M8 14h.01" />
                      <path d="M12 18h.01" />
                      <path d="M8 18h.01" />
                    </svg>
                  )}
                </span>
                <span
                  class={`px-2.5 py-1 rounded-full font-mono text-[10px] tracking-widest uppercase border ${
                    tool.status === 'live'
                      ? 'bg-green-50 text-green-700 border-green-200'
                      : 'bg-amber-50 text-amber-700 border-amber-200'
                  }`}
                >
                  {tool.status === 'live' ? '● Live' : 'Coming soon'}
                </span>
              </div>

              <h3 class="mt-5 text-lg font-bold text-slate-800">{tool.name}</h3>
              <p class="mt-1 text-sm font-medium text-slate-500">{tool.tagline}</p>
              <p class="mt-3 text-sm text-slate-600 leading-relaxed flex-1">{tool.description}</p>

              {tool.status === 'live' ? (
                <a
                  href={tool.url}
                  class="mt-6 inline-flex items-center gap-2 text-sm font-mono text-blue-700 hover:text-blue-900 transition-colors"
                >
                  Open tool →
                </a>
              ) : (
                <span class="mt-6 inline-flex items-center gap-2 text-sm font-mono text-slate-600">
                  In development
                </span>
              )}
            </div>
          ))}
        </div>
      </section>

      <!-- Why it's free -->
      <section class="mb-24 md:mb-32 relative">
        <p class="font-mono text-xs text-slate-400 uppercase tracking-widest">02 / Why it&apos;s free</p>
        <h2 class="mt-3 font-hand text-4xl md:text-5xl text-slate-800 max-w-2xl">
          Every free tool earns trust
        </h2>

        <div class="mt-10 grid grid-cols-1 md:grid-cols-2 gap-6">
          {valueProps.map((prop) => (
            <div class="bg-slate-900 text-slate-100 p-6 md:p-8 rounded-2xl relative overflow-hidden">
              <div class="absolute top-0 right-0 w-40 h-40 bg-blue-600/20 rounded-full blur-3xl -translate-y-1/2 translate-x-1/2 pointer-events-none" />
              <h3 class="relative text-xl font-bold">{prop.title}</h3>
              <p class="relative mt-3 text-slate-400 leading-relaxed font-light">{prop.body}</p>
            </div>
          ))}
        </div>

        <div class="mt-10 flex flex-wrap items-center gap-x-6 gap-y-2 font-mono text-xs text-slate-500">
          <span class="inline-flex items-center gap-2"><span class="w-2 h-2 bg-green-400 rounded-full animate-pulse"></span>Tool 1 of 5 live</span>
          <span class="inline-flex items-center gap-2">🔒 Documents generated locally in your browser</span>
          <span class="inline-flex items-center gap-2">📊 Anonymous usage analytics only</span>
        </div>
      </section>

      <!-- CTA -->
      <section class="mb-16 relative">
        <div class="bg-slate-900 text-slate-100 p-8 md:p-14 rounded-2xl relative overflow-hidden text-center">
          <div class="absolute top-0 right-0 w-96 h-96 bg-blue-600/20 rounded-full blur-3xl -translate-y-1/2 translate-x-1/2 pointer-events-none"></div>
          <div class="absolute bottom-0 left-0 w-64 h-64 bg-yellow-500/10 rounded-full blur-3xl translate-y-1/2 -translate-x-1/2 pointer-events-none"></div>

          <div class="relative z-10">
            <span class="inline-block px-3 py-1 rounded-full bg-slate-800 text-yellow-300 font-mono text-xs mb-6 border border-slate-700">
              STATUS: BUILDING
            </span>
            <h2 class="font-hand text-4xl md:text-5xl text-slate-100">
              Want a tool built for <span class="text-transparent bg-clip-text bg-gradient-to-r from-yellow-200 to-yellow-500 italic">your</span> business?
            </h2>
            <p class="mt-5 max-w-xl mx-auto text-slate-400 text-lg font-light">
              We build custom web apps, dashboards, and automation for Malaysian businesses. The toolkit is our way of giving back — and a taste of how we work.
            </p>
            <div class="mt-8 flex flex-wrap justify-center gap-4">
              <a
                href="/#booking"
                class="bg-blue-700 text-white rounded-xl px-6 py-3 font-mono text-sm hover:bg-blue-800 active:scale-[0.98] transition-all"
              >
                Book a free call
              </a>
              <a
                href="/#projects"
                class="border border-slate-600 text-slate-300 rounded-xl px-6 py-3 font-mono text-sm hover:border-slate-400 hover:text-white transition-colors"
              >
                See our work
              </a>
            </div>
          </div>
        </div>
      </section>
    </main>

    <FooterSection />

    <!-- JSON-LD: ItemList -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "ItemList",
      "name": "HaikaiTech Business Toolkit",
      "description": "Free business tools for Malaysian SMEs.",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Invoice Generator", "url": "https://invoice.haikaitech.my" },
        { "@type": "ListItem", "position": 2, "name": "Quotation Builder" },
        { "@type": "ListItem", "position": 3, "name": "Receipt Maker" },
        { "@type": "ListItem", "position": 4, "name": "Purchase Order" },
        { "@type": "ListItem", "position": 5, "name": "Payroll Calculator" }
      ]
    }
    </script>
    <!-- JSON-LD: SoftwareApplication -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "SoftwareApplication",
      "name": "HaikaiTech Invoice Generator",
      "url": "https://invoice.haikaitech.my",
      "applicationCategory": "BusinessApplication",
      "operatingSystem": "Any",
      "offers": { "@type": "Offer", "price": "0", "priceCurrency": "MYR" },
      "description": "Free online invoice generator for Malaysian SMEs — no login, clean PDFs, no watermark."
    }
    </script>
  </div>
</BaseLayout>
